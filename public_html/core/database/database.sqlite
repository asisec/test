INSERT INTO `pages` VALUES (2,'İletişim','iletisim','<h2 class=\"tittle p-0\" style=\"margin-bottom: 18px; line-height: 1.4; font-size: 36px; font-family: var(--heading-font); padding-left: 12px; display: inline-block; position: relative;\"><b>Get in touch</b></h2><p><span style=\"color: rgb(102, 112, 133); font-family: &quot;Source Sans Pro&quot;, sans-serif; display: inline !important;\"></span></p><p style=\"color: rgb(102, 112, 133); font-family: &quot;Source Sans Pro&quot;, sans-serif; line-height: 1.6;\">Our friendly team would love to hear from you.</p>',NULL,'normal_layout',NULL,'on','02','02',NULL,NULL,NULL,'all',NULL,'on','publish','2024-01-30 00:15:39','2025-02-07 20:41:51'),(3,'Ana Sayfa','ana-sayfa',NULL,NULL,'home_page_layout',NULL,NULL,'02','02',NULL,NULL,NULL,'all',NULL,'on','publish','2024-01-30 00:16:57','2025-02-06 10:55:51'),(5,'Şartlar ve Koşullar','sartlar-kosullar','<div><font color=\"#667085\" face=\"Source Sans Pro, sans-serif\"><span style=\"font-size: 16px;\"><br></span></font></div>',NULL,'normal_layout',NULL,'on','02','02',NULL,NULL,NULL,'all',NULL,'on','publish','2024-01-30 00:45:39','2026-06-12 09:23:53'),(6,'Gizlilik Politikası','gizlilik-politikasi','<h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\"><b>Gizlilik Politikası - Textile Forum</b></span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\"><br></span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\"><b>Giriş</b></span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\"><b><br></b></span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\">Textile Forum ailesi olarak, sizin gizliliğinizi ciddiye alıyoruz. Bu politika, Textileforum.net kullanırken topladığımız, işlediğimiz ve kullandığımız bilgileri açıklıyor. Platformumuzu kullanarak, bu politikayı kabul etmiş sayılırsınız.</span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\"><br></span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\"><b>1. Topladığımız Bilgiler ve Kullanım Amaçları</b></span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\"><br></span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\">Textile Forum\'da ilan vermek ve diğer üyelerle iletişim kurmak için birtakım bilgileri toplarız:</span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\"><br></span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\">Kişisel Bilgiler: Adınız, soyadınız, e-posta adresiniz, telefon numaranız gibi temel bilgiler.</span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\">İlan Bilgileri: İlanlarınızda paylaştığınız açıklamalar, görseller ve iletişim detayları.</span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\">Hesap Bilgileri: Kullanıcı adınız ve şifreniz gibi hesap yönetimi için gereken bilgiler.</span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\">Teknik Veriler: IP adresiniz, kullandığınız tarayıcı ve siteye erişim zamanları gibi teknik detaylar.</span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\"><br></span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\">Bu bilgiler, sizin platformu kullanım deneyiminizi iyileştirmek, güvenliği sağlamak ve Textile Forum\'un hizmet kalitesini artırmak için kullanılır.</span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\"><b><br></b></span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\"><b>2. Bilgilerin Paylaşımı ve Görünürlüğü</b></span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\"><b><br></b></span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\">İlanlarınızda paylaştığınız bilgiler, platformun diğer kullanıcıları tarafından görülebilir. Örneğin, telefon numaranızı veya e-posta adresinizi eklediyseniz, bu bilgilere diğer kullanıcılar erişebilir. Bilgilerinizi nasıl paylaştığınız size kalmış, ancak bu konuda dikkatli olmanızı öneririz. Resmi makamların talebi üzerine, yasal gereklilikler doğrultusunda bilgilerinizi paylaşabiliriz.</span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\"><br></span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\"><b>3. Veri Güvenliği</b></span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\"><br></span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\">Kullanıcı bilgilerinizin güvenliğini sağlamak için elimizden geleni yapıyoruz. Ancak, internet üzerinden veri paylaşımının tamamen güvenli olmadığını hatırlatmak isteriz. İlanlarınızı oluştururken paylaştığınız bilgilerin herkese açık olabileceğini unutmayın.</span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\"><br></span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\"><b>4. Çerezler ve İzleme Teknolojileri</b></span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\"><br></span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\">Textileforum.net, sizlere daha iyi bir deneyim sunmak için çerezler kullanıyor. Çerezler:</span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\"><br></span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\">Oturum bilgilerinizi korur.</span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\">Kişisel tercihlerinizi hatırlar.</span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\">Platform kullanımını analiz eder.</span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\"><br></span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\">Çerez ayarlarınızı tarayıcınızdan değiştirebilirsiniz, ancak bazı hizmetler çerezlerin aktifliğine bağlıdır.</span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\"><br></span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\"><b>5. Kullanıcı Hakları</b></span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\"><br></span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\">Textile Forum\'da şunları yapabilirsiniz:</span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\"><br></span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\">Hesap bilgilerinizi görüntüleyip, değiştirebilir veya silebilirsiniz.</span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\">İlanlarınızı güncelleyebilir veya kaldırabilirsiniz.</span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\">Kişisel verilerinizin nasıl kullanıldığı hakkında bilgi talep edebilirsiniz.</span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\"><br></span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\">Gizlilik veya veri güvenliği ile ilgili sorularınız için bize info@textileforum.net üzerinden ulaşabilirsiniz.</span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\"><br></span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\"><b>6. Politika Güncellemeleri</b></span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\"><br></span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\">Gizlilik politikamız zamanla değişebilir. Güncellemeleri takip etmek sizin sorumluluğunuzda. Güncellenmiş politika, Textileforum.net\'te yayınlandığında yürürlüğe girer.</span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\"><br></span></font></h1><h1 style=\"padding: 0px; line-height: 1.08333; outline-style: initial; outline-width: 0px;\"><font face=\"Roboto, sans-serif\"><span style=\"font-size: 18px;\">Textile Forum olarak, güvenli ve şeffaf bir ticaret ortamı sağlamayı hedefliyoruz. Bilgilerinizi nasıl paylaşacağınız konusunda bilinçli olmanızı teşvik ediyoruz.</span></font></h1>',NULL,'normal_layout',NULL,'on','02','02',NULL,NULL,NULL,'all',NULL,'on','publish','2024-01-30 00:45:56','2025-02-06 02:37:02'),(7,'Faq','faq',NULL,NULL,'normal_layout',NULL,'on','02','02',NULL,NULL,NULL,'all',NULL,'on','draft','2024-01-30 00:46:28','2025-01-29 21:40:36'),(8,'Safety Informations','safety-informations','<p><strong><br></strong></p><p><strong><br></strong></p><p><strong><br></strong></p><p><strong>Safety Information</strong></p>\r\n<p>At Listocean, your safety and security are our top priorities. We want to ensure that you have a safe and enjoyable experience while using our website. Please take a moment to review the following safety tips and guidelines:</p><p><br></p>\r\n<ol>\r\n<li>\r\n<p><strong>Protect Your Personal Information:</strong></p>\r\n<ul>\r\n<li>Be cautious when sharing personal information online, such as your full name, address, phone number, or financial details.</li>\r\n<li>Avoid posting sensitive information publicly on the website, including in comments, reviews, or forum discussions.</li>\r\n<li>Use strong and unique passwords for your account and avoid sharing them with others.</li></ul></li></ol><ol>\r\n<li>\r\n<p><strong>Beware of Scams and Fraud:</strong></p>\r\n<ul>\r\n<li>Be wary of offers that seem too good to be true, especially those requesting payment or personal information upfront.</li>\r\n<li>Do not respond to unsolicited emails, messages, or requests for money or personal information.</li>\r\n<li>If something seems suspicious or fraudulent, report it to us immediately so we can investigate.</li></ul></li></ol><ol>\r\n<li>\r\n<p><strong>Use Secure Payment Methods:</strong></p>\r\n<ul>\r\n<li>Only make payments through secure and trusted payment gateways provided on our website.</li>\r\n<li>Verify the legitimacy of sellers and listings before making a purchase, especially for high-value items.</li></ul></li></ol><ol>\r\n<li>\r\n<p><strong>Stay Vigilant Against Phishing Attacks:</strong></p>\r\n<ul>\r\n<li>Be cautious of emails or messages that ask you to click on suspicious links or provide sensitive information.</li>\r\n<li>Look for signs of phishing, such as misspelled email addresses, unfamiliar senders, and urgent requests for personal information.</li>\r\n<li>If in doubt, contact us directly through our official channels to verify the authenticity of the communication.</li></ul></li></ol><ol>\r\n<li>\r\n<p><strong>Practice Safe Online Interactions:</strong></p>\r\n<ul>\r\n<li>Use caution when communicating with strangers online, especially in private messages or chat rooms.</li>\r\n<li>Report any inappropriate or abusive behavior to us immediately, and block the user if necessary.</li>\r\n<li>Trust your instincts and avoid engaging in risky or potentially dangerous situations.</li></ul></li></ol><ol>\r\n<li>\r\n<p><strong>Protect Your Devices and Accounts:</strong></p>\r\n<ul>\r\n<li>Keep your devices, operating systems, and antivirus software up to date with the latest security patches.</li>\r\n<li>Enable two-factor authentication (2FA) for an extra layer of security on your accounts.</li>\r\n<li>Be cautious of public Wi-Fi networks and use a virtual private network (VPN) when accessing sensitive information online.</li></ul></li></ol><ol>\r\n<li>\r\n<p><strong>Report Safety Concerns:</strong></p>\r\n<ul>\r\n<li>If you encounter any safety issues, suspicious activity, or violations of our community guidelines, please report them to us immediately.</li>\r\n<li>Your feedback helps us maintain a safe and secure environment for all users.</li></ul></li></ol>\r\n<p>Remember, your safety is our priority, but ultimately, you are responsible for your own safety and security while using our website. By following these safety tips and guidelines, you can help protect yourself and others from potential risks and dangers online.</p>\r\n<p>If you have any questions or concerns about safety on our website, please don\'t hesitate to contact us. Thank you for being a valued member of our community!</p><p><br></p><p><br></p><p><br></p><p><br></p>',NULL,'normal_layout',NULL,'on','01','01',NULL,NULL,NULL,'all',NULL,NULL,'publish','2024-01-30 00:46:35','2024-06-27 10:34:23'),(13,'Test Page','test-page','<p><div style=\"margin: 0px 28.7969px 0px 14.3906px; padding: 0px; width: 436.797px; text-align: left; float: right; color: rgb(0, 0, 0); font-family: &quot;Open Sans&quot;, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;\"></div></p><div style=\"text-align: justify;\"><span style=\"text-align: var(--bs-body-text-align); display: inline !important; font-size: 16px;\"><font face=\"Open Sans, Arial, sans-serif\"><b>Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry\'s standard dummy text ever since the 1500s, when an unknown printer took a galley of type and scrambled it to make a type specimen book. It has survived not only five centuries, but also the leap into electronic typesetting, remaining essentially unchanged. It was popularised in the 1960s with the release of Letraset sheets containing Lorem Ipsum passages, and more recently with desktop publishing software like Aldus PageMaker including versions of Lorem Ipsum</b></font></span></div><div style=\"text-align: justify;\"><span style=\"text-align: var(--bs-body-text-align); display: inline !important; font-size: 16px;\"><font face=\"Open Sans, Arial, sans-serif\"><b><br></b></font></span></div><div style=\"margin: 0px 28.7969px 0px 14.3906px; padding: 0px; width: 436.797px; float: right; color: rgb(0, 0, 0); font-family: &quot;Open Sans&quot;, Arial, sans-serif;\"></div>',NULL,'normal_layout',NULL,'on','01','01',NULL,NULL,NULL,'all',NULL,'on','draft','2024-01-30 01:58:40','2024-06-05 05:36:49'),(14,'Üyelikler','uyelikler',NULL,NULL,'normal_layout',NULL,'on','02','02',NULL,NULL,NULL,'all',NULL,'on','draft','2024-02-14 00:53:33','2026-06-08 00:51:47'),(15,'Blog','blog',NULL,NULL,'normal_layout',NULL,'on','01','02',NULL,NULL,NULL,'all',NULL,'on','draft','2024-02-14 00:53:56','2025-01-28 21:54:34'),(17,'Hakkımızda','hakkimizda','<div bis_skin_checked=\"1\"><b>Hakkımızda - Textile Forum</b></div><div bis_skin_checked=\"1\"><b>Tekstil Sektörünün Yenilikçi Gücü</b></div><div bis_skin_checked=\"1\"><br></div><div bis_skin_checked=\"1\">Textile Forum, tekstil endüstrisinde köklü bir değişim yaratma amacıyla doğdu. Üreticileri, tedarikçileri, perakendecileri ve alıcıları tek bir çatı altında toplayarak, sektör içi ticaretin hem hızını hem de verimliliğini artırmayı hedefliyoruz. Textileforum.net üzerinden, tekstil sektörünü dijital çağa taşıyor, alım-satım işlemlerini yeniden tasarlıyoruz.</div><div bis_skin_checked=\"1\"><br></div><div bis_skin_checked=\"1\"><b>Textile Forum Neden Farklı?</b></div><div bis_skin_checked=\"1\"><br></div><div bis_skin_checked=\"1\">Kolay ve Hızlı Alım-Satım: Kullanıcılarımız, tekstil ürünleri ve hizmetlerini kolaylıkla ilan edebilecekleri, kullanıcı dostu bir platforma sahip. Gelişmiş arama ve filtreleme seçenekleri sayesinde, tam da aradığınız ürünlere birkaç tıkla ulaşabilirsiniz.</div><div bis_skin_checked=\"1\">Geniş Ürün ve Kategori Yelpazesi: Kumaştan tekstil makinelerine, moda aksesuarlarından niş ürünlere kadar her türlü tekstil ürünü için özel kategorilerimiz var. Her sektörden işletme ve birey için kapsamlı bir çözüm sunuyoruz.</div><div bis_skin_checked=\"1\">Güven Odaklı Ticareti: Textile Forum, güvenli ve şeffaf bir ticaret ortamı sağlamak için kullanıcı değerlendirme ve yorum sistemlerini kullanır. Bu sayede, iş partnerlerinizin geçmiş deneyimlerine dair bilgi edinerek daha güvenli iş ilişkileri kurabilirsiniz.</div><div bis_skin_checked=\"1\">Eğitim ve Bilgi Kaynağı: Sadece bir ticaret platformu değil, tekstil sektörü hakkında en son haberleri, eğitim içeriklerini ve trend analizlerini sunan bir bilgi merkeziyiz. Burada, rekabet avantajı kazanmak için ihtiyaç duyduğunuz tüm bilgilere ulaşabilirsiniz.</div><div bis_skin_checked=\"1\">Küresel Pazar Erişimi: Uluslararası ticareti kolaylaştırmak için çoklu dil desteği, döviz kuru bilgileri ve lojistik rehberleri sunuyoruz. Textile Forum ile dünyanın her yerine ulaşabilirsiniz.</div><div bis_skin_checked=\"1\">Reklam ve İşbirliği Fırsatları: Markanızı büyütmek ve geniş kitlelere ulaşmak için çeşitli reklam ve işbirliği seçenekleri sunuyoruz. Stratejik ortaklıklarla, sizi sektörün öncü isimlerinden biri yapmak için çalışıyoruz.</div><div bis_skin_checked=\"1\"><br></div><div bis_skin_checked=\"1\"><b>Textile Forum ile Dijital Dönüşüm!</b></div><div bis_skin_checked=\"1\"><br></div><div bis_skin_checked=\"1\">Misyonumuz, tekstil sektörünü dijitalleştirerek modern ticaretin gereksinimlerine uyum sağlamak. Textile Forum, kullanıcılarına işlerini büyütme, sektördeki etkileşimlerini artırma ve yenilikçi çözümler sunma imkanı sağlıyor.</div><div bis_skin_checked=\"1\"><br></div><div bis_skin_checked=\"1\">Gelin, Textile Forum\'un sunduğu bu ayrıcalıkları keşfedin ve tekstil ticaretinizi dijital dünyanın gücüyle bir adım öne taşıyın!</div><div bis_skin_checked=\"1\"><br></div><div bis_skin_checked=\"1\">Bize Katılın ve Textile Forum\'un Ayrıcalıklarını Keşfedin!</div>',NULL,'normal_layout',NULL,'on','02','02',NULL,NULL,NULL,'all',NULL,'on','publish','2024-03-13 00:57:53','2025-02-06 02:37:29'),(18,'İlanlar','ilanlar',NULL,NULL,'normal_layout',NULL,'on','02','02',NULL,NULL,NULL,'all',NULL,'on','publish','2024-04-18 06:40:29','2026-06-08 00:32:59'),(19,'Tips to Maintain Consistency','tips-to-maintain-consistency','<h3><span style=\"font-size: 24px;\"><b><br></b></span></h3><h3><span style=\"font-size: 24px;\"><b><br></b></span></h3><h3><span style=\"font-size: 24px;\"><b><br></b></span></h3><h3><span style=\"font-size: 24px;\"><b>10 Tips to Maintain Consistency in Your Campaign</b></span></h3><p><br></p><h4><b><span style=\"font-size: 18px;\">1. Define Clear Goals and Objectives</span></b></h4><p>Start by outlining clear and achievable goals for your campaign. Understand what you want to accomplish and set measurable objectives. This will serve as a roadmap and help maintain focus throughout the campaign.</p><p><br></p><h4><span style=\"font-size: 18px;\"><b>2. Develop a Comprehensive Plan</b></span></h4><p>Create a detailed campaign plan that includes timelines, tasks, and milestones. A well-structured plan ensures that every team member knows their responsibilities and deadlines, promoting consistency in execution.</p><p><br></p><h4><b><span style=\"font-size: 18px;\">3. Establish Brand Guidelines</span></b></h4><p>Ensure that your campaign aligns with your brand’s identity. Develop and adhere to brand guidelines that cover your logo, colors, fonts, tone of voice, and messaging. Consistency in branding helps in building brand recognition and trust.</p><p><br></p><h4><b><span style=\"font-size: 18px;\">4. Use a Content Calendar</span></b></h4><p>Organize your campaign content using a content calendar. Plan your posts, emails, ads, and other communications in advance. This will help you maintain a steady flow of content and ensure that all campaign elements are well-coordinated.</p><p><br></p><h4><b><span style=\"font-size: 18px;\">5. Leverage Automation Tools</span></b></h4><p>Utilize automation tools to schedule and manage your campaign activities. Tools like social media schedulers, email marketing platforms, and project management software can help you stay on track and maintain consistency in your efforts.</p><p><br></p><h4><b><span style=\"font-size: 18px;\">6. Maintain Regular Communication</span></b></h4><p>Keep the lines of communication open with your team. Regular meetings and updates help ensure everyone is on the same page. Address any issues promptly and make adjustments as needed to stay aligned with your campaign goals.</p><p><br></p><h4><b><span style=\"font-size: 18px;\">7. Monitor Performance Metrics</span></b></h4><p>Track the performance of your campaign using key metrics. Analyze data regularly to see what’s working and what’s not. Consistent monitoring allows you to make informed decisions and adjustments to improve campaign effectiveness.</p><p><br></p><h4><span style=\"font-size: 18px;\"><b>8. Engage with Your Audience</b></span></h4><p>Consistency in engagement is key to building a loyal audience. Respond to comments, messages, and feedback promptly. Show your audience that you are active and value their input, which helps in maintaining a positive and consistent brand image.</p><p><br></p><h4><b><span style=\"font-size: 18px;\">9. Adapt to Feedback and Changes</span></b></h4><p>Be prepared to adapt your campaign based on feedback and changing circumstances. Flexibility is important, but ensure that any changes align with your overall strategy and brand identity to maintain consistency.</p><p><br></p><h4><b><span style=\"font-size: 18px;\">10. Evaluate and Reflect</span></b></h4><p>After the campaign ends, conduct a thorough evaluation. Reflect on what worked well and what didn’t. Use these insights to improve future campaigns and maintain a consistent approach to achieving your marketing goals.</p><p><br></p><p><br></p><p><br></p>',NULL,'normal_layout',NULL,'on','01','01',NULL,NULL,NULL,'all',NULL,NULL,'publish','2024-06-22 00:24:20','2024-06-27 10:34:47'),(20,'KVKK Politikası','kvkk-politikas-',NULL,NULL,'normal_layout',NULL,NULL,'02','02',NULL,NULL,NULL,'all',NULL,'on','publish','2025-02-06 02:39:57','2025-02-06 02:39:57'),(21,'About Us','hakkimizda-en','test',NULL,'normal_layout',NULL,'on','02','02',NULL,NULL,NULL,'all','on','on','publish','2024-03-13 00:57:53','2025-02-06 02:37:29'),(22,'关于我们','hakkimizda-chine','',NULL,'normal_layout',NULL,'on','02','02',NULL,NULL,NULL,'all','on','on','publish','2024-03-13 00:57:53','2025-02-06 02:37:29'),(23,'Terms and Conditions','sartlar-ve-kosullar-en','',NULL,'normal_layout',NULL,'on','02','02',NULL,NULL,NULL,'all','on','on','publish','2024-01-30 00:45:39','2025-02-06 02:28:12'),(24,'服务条款','sartlar-ve-kosullar-chine','',NULL,'normal_layout',NULL,'on','02','02',NULL,NULL,NULL,'all','on','on','publish','2024-01-30 00:45:39','2025-02-06 02:28:12'),(25,'Privacy Policy ','gizlilik-politikasi-en','Privacy Policy - Textile Forum\r\nIntroduction\r\nAt Textile Forum, we take your privacy seriously. This policy explains the information we collect, process, and use when you visit TextileForum.net. By using our platform, you agree to the terms outlined in this policy.\r\n1. Information We Collect and Its Purpose\r\nTo facilitate listings and communication between members, we collect certain types of data:\r\n* Personal Information: Your name, surname, email address, and phone number.\r\n* Listing Information: Descriptions, images, and contact details you provide in your listings.\r\n* Account Information: Username, password, and other details necessary for account management.\r\n* Technical Data: Your IP address, browser type, and access timestamps.\r\nThis information is used to enhance your experience, ensure security, and improve Textile Forum’s service quality.\r\n2. Data Sharing and Visibility\r\nThe information you share in your listings is visible to other platform users. For example, if you include your phone number or email, other users can access this information. You have control over what you share, but we advise caution when providing personal details.\r\nAdditionally, we may share data with official authorities if legally required.\r\n3. Data Security\r\nWe take measures to protect user information. However, it is important to remember that no online data transmission is completely secure. Information shared in listings may be publicly accessible.\r\n4. Cookies and Tracking Technologies\r\nTextileForum.net uses cookies to improve your experience. Cookies help to:\r\n* Maintain session information.\r\n* Remember your preferences.\r\n* Analyze platform usage.\r\nYou can adjust cookie settings in your browser, but some services may depend on cookies being enabled.\r\n5. User Rights\r\nAs a Textile Forum user, you have the right to:\r\n* View, modify, or delete your account information.\r\n* Update or remove your listings.\r\n* Request information about how your personal data is used.\r\nFor privacy or data security concerns, you can contact us at info@textileforum.net.\r\n6. Policy Updates\r\nThis privacy policy may change over time. It is your responsibility to stay updated. The revised policy becomes effective once published on TextileForum.net.\r\nAt Textile Forum, we are committed to maintaining a secure and transparent trade environment. We encourage users to be mindful of the information they share.',NULL,'normal_layout',NULL,'on','02','02',NULL,NULL,NULL,'all',NULL,'on','publish','2024-01-30 00:45:56','2025-02-06 02:37:02'),(26,'隐私政策','gizlilik-politikasi-chine','',NULL,'normal_layout',NULL,'on','02','02',NULL,NULL,NULL,'all',NULL,'on','publish','2024-01-30 00:45:56','2025-02-06 02:37:02'),(27,'Personal Data Protection Law (KVKK) Information Notice','kvkk-politikas-en',NULL,NULL,'normal_layout',NULL,NULL,'02','02',NULL,NULL,NULL,'all',NULL,'on','publish','2025-02-06 02:39:57','2025-02-06 02:39:57'),(28,'个人数据保护法（KVKK）说明声明','kvkk-politikas-chine',NULL,NULL,'normal_layout',NULL,NULL,'02','02',NULL,NULL,NULL,'all',NULL,'on','publish','2025-02-06 02:39:57','2025-02-06 02:39:57');
