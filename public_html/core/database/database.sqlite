main-card-image\">\r\n                    <img src=\"http://localhost:8081/assets/uploads/no-image.png\" class=\"no-image\" alt=\"\"/>\r\n                </a>\r\n            </div>\r\n            <div class=\"featurebody\">\r\n                <div class=\"card-body-top\">\r\n                    <h4> <a href=\"http://localhost:8081/listing/dornier-jet-labeler-180cmjc5-cx870-1408-hook-7046\" class=\"featureTittle head4 twoLine\">آلة وضع الملصقات النفاثة من طراز Dornier 180 سم + jc5 cx870 1408 hook</a> </h4>\r\n                </div>\r\n\r\n                <p class=\"featureCap d-flex align-items-center gap-1\">\r\n            <svg width=\"16\" height=\"17\" viewBox=\"0 0 16 17\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n            <path d=\"M5.99984 7.83332C5.99984 8.36376 6.21055 8.87246 6.58562 9.24754C6.9607 9.62261 7.4694 9.83332 7.99984 9.83332C8.53027 9.83332 9.03898 9.62261 9.41405 9.24754C9.78912 8.87246 9.99984 8.36376 9.99984 7.83332C9.99984 7.30289 9.78912 6.79418 9.41405 6.41911C9.03898 6.04404 8.53027 5.83332 7.99984 5.83332C7.4694 5.83332 6.9607 6.04404 6.58562 6.41911C6.21055 6.79418 5.99984 7.30289 5.99984 7.83332Z\" stroke=\"#64748B\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\r\n            <path d=\"M11.7712 11.6047L8.94251 14.4333C8.6925 14.6831 8.35356 14.8234 8.00017 14.8234C7.64678 14.8234 7.30785 14.6831 7.05784 14.4333L4.22851 11.6047C3.48265 10.8588 2.97473 9.90845 2.76896 8.8739C2.5632 7.83934 2.66883 6.767 3.07251 5.79247C3.47618 4.81795 4.15977 3.98501 5.03683 3.39899C5.91388 2.81297 6.94502 2.50018 7.99984 2.50018C9.05466 2.50018 10.0858 2.81297 10.9629 3.39899C11.8399 3.98501 12.5235 4.81795 12.9272 5.79247C13.3308 6.767 13.4365 7.83934 13.2307 8.8739C13.0249 9.90845 12.517 10.8588 11.7712 11.6047Z\" stroke=\"#64748B\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\r\n        </svg>\r\n         <span class=\"oneLine\">تركيا \r\n</span></p>\r\n\r\n                <div class=\"btn-wrapper\">\r\n                                    </div>\r\n\r\n                \r\n                                            <span class=\"featurePricing d-flex justify-content-between align-items-center\"><span class=\"money text-primary\" style=\"font-size: 15px;\">يرجى الاتصال لمعرفة السعر</span>\r\n                                        \r\n                                            \r\n                \r\n            </span></div>\r\n        </div>\r\n                                            </div>\r\n                                    </div>\r\n                                </div>\r\n                            \r\n                            <!-- List View -->\r\n                            \r\n                        </div>\r\n\r\n                        <!--Google Map-->\r\n                                                                                                    </div>\r\n\r\n                    <!-- Pagination -->\r\n                    <div class=\"row justify-content-center\">\r\n                        <div class=\"col-lg-12\">\r\n                            <div class=\"pagination mt-60\">\r\n                                                                    <div class=\"blog-pagination\">\r\n                                        <div class=\"custom-pagination mt-4 mt-lg-5\">\r\n                                            <nav>\n        <ul class=\"pagination\">\n            \n                            <li class=\"page-item disabled\" aria-disabled=\"true\" aria-label=\"« السابق\">\n                    <span class=\"page-link\" aria-hidden=\"true\">‹</span>\n                </li>\n            \n            \n                            \n                \n                \n                                                                                        <li class=\"page-item active\" aria-current=\"page\"><span class=\"page-link\">1</span></li>\n                                                                                                <li class=\"page-item\"><a class=\"page-link\" href=\"http://localhost:8081/ilanlar?page=2\">2</a></li>\n                                                                                                <li class=\"page-item\"><a class=\"page-link\" href=\"http://localhost:8081/ilanlar?page=3\">3</a></li>\n                                                                                                <li class=\"page-item\"><a class=\"page-link\" href=\"http://localhost:8081/ilanlar?page=4\">4</a></li>\n                                                                                                <li class=\"page-item\"><a class=\"page-link\" href=\"http://localhost:8081/ilanlar?page=5\">5</a></li>\n                                                                                                <li class=\"page-item\"><a class=\"page-link\" href=\"http://localhost:8081/ilanlar?page=6\">6</a></li>\n                                                                                                <li class=\"page-item\"><a class=\"page-link\" href=\"http://localhost:8081/ilanlar?page=7\">7</a></li>\n                                                                        \n            \n                            <li class=\"page-item\">\n                    <a class=\"page-link\" href=\"http://localhost:8081/ilanlar?page=2\" rel=\"next\" aria-label=\"التالي »\">›</a>\n                </li>\n                    </ul>\n    </nav>\n\r\n                                        </div>\r\n                                    </div>\r\n                                                            </div>\r\n                        </div>\r\n                    </div>\r\n\r\n                </div>\r\n            </div>\r\n        </form>\r\n    </div>\r\n</div>\r\n\r\n        <script src=\"https://cdnjs.cloudflare.com/ajax/libs/noUiSlider/14.6.3/nouislider.min.js\"></script>\r\n    \r\n        <script>\r\n            (function($){\r\n                &quot;use strict&quot;;\r\n                $(document).ready(function(){\r\n                    $(document).on(&#x27;click&#x27;, &#x27;#price_wise_filter_apply&#x27;, function (){\r\n                        let left_value = $(&#x27;.input-min&#x27;).val();\r\n                        let right_value = $(&#x27;.input-max&#x27;).val();\r\n                        $(&#x27;#price_range_value&#x27;).val(left_value + &#x27;,&#x27; + right_value);\r\n\r\n                        // google map km set\r\n                        let distance_km_value = $(&#x27;#slider-value&#x27;).text();\r\n                        $(&#x27;#distance_kilometers_value&#x27;).val(distance_km_value);\r\n                        let get_autocomplete_value = $(&#x27;#autocomplete&#x27;).val();\r\n                        $(&#x27;#autocomplete_address&#x27;).val(get_autocomplete_value);\r\n\r\n                        $(&#x27;#search_listings_form&#x27;).trigger(&#x27;submit&#x27;);\r\n                    });\r\n                });\r\n            })(jQuery);\r\n        </script>\r\n\r\n            <script>\r\n            const rangeInput = document.querySelectorAll(&quot;.range-input input&quot;),\r\n                priceInput = document.querySelectorAll(&quot;.price-input input&quot;),\r\n                range = document.querySelector(&quot;.price_range_setup .progress&quot;);\r\n            let priceGap = 10;\r\n\r\n            var slider_price_div = document.querySelector(&#x27;.price_range_setup .progress&#x27;);\r\n            var maxPriceValue = 1212;\r\n            noUiSlider.create(slider_price_div, {\r\n                start: [ 1 ,  1212 ],\r\n                connect: true,\r\n                range: {\r\n                    &#x27;min&#x27;: 1,\r\n                    &#x27;max&#x27;: maxPriceValue\r\n                },\r\n                pips: {\r\n                    mode: &#x27;steps&#x27;,\r\n                    stepped: true,\r\n                    density: 4\r\n                }\r\n            });\r\n\r\n            slider_price_div.noUiSlider.on(&#x27;update&#x27;, function (values) {\r\n                $(&quot;.input-min&quot;).val(Math.round(values[0]));\r\n                $(&quot;.input-max&quot;).val(Math.round(values[1]));\r\n            });\r\n\r\n            // INPUT\r\n            priceInput.forEach(input =&gt; {\r\n                input.addEventListener(&quot;input&quot;, e =&gt; {\r\n                    let minPrice = parseInt(priceInput[0].value),\r\n                        maxPrice = parseInt(priceInput[1].value);\r\n\r\n                    if ((maxPrice - minPrice) &gt;= priceGap &amp;&amp; maxPrice &lt;= slider_price_div.noUiSlider.options.range.max) {\r\n                        if (e.target.className === &quot;input-min&quot;) {\r\n                            slider_price_div.noUiSlider.set([minPrice, null]);\r\n                        } else {\r\n                            slider_price_div.noUiSlider.set([null, maxPrice]);\r\n                        }\r\n                    }\r\n                });\r\n            });\r\n        </script>\r\n    \r\n','2026-08-19 09:43:35','2026-08-19 09:43:35'),(3421,'7c2c1d4922b998b3287c1fe8804e3341','AR','    <section class=\"text-editor-area\" data-padding-top=\"54\" data-padding-bottom=\"62\">\r\n        <div class=\"container-1440\">\r\n            <div class=\"row\">\r\n                <div class=\"col-lg-12\">\r\n                     <p><span style=\"color: var(--paragraph-color); text-align: var(--bs-body-text-align);\">الشروط والأحكام - منتدى المنسوجات</span></p><p><br></p><p>1. مقدمة</p><p><span style=\"font-weight: normal;\">تسري هذه الشروط والأحكام على جميع المستخدمين الذين يستخدمون خدمات Textileforum.net (المشار إليها فيما يلي بـ &quot;المنصة&quot;). باستخدام المنصة، فإنك تقبل الشروط التالية. إذا كنت لا توافق على هذه الشروط، فيجب عليك الامتناع عن استخدام المنصة.</span></p><p><br></p><p>2. تعريف الخدمة</p><p><span style=\"font-weight: normal;\">Textile Forum هو منصة للإعلان والتواصل مخصصة لقطاع المنسوجات. يمكن للمستخدمين نشر إعلانات على المنصة بهدف بيع منتجات المنسوجات أو شرائها أو العثور على موردين. Textile Forum هو مجرد وسيط ولا يعتبر طرفًا في أي معاملات تجارية بأي شكل من الأشكال.</span></p><p><br></p><p>3. إخلاء المسؤولية</p><p><span style=\"font-weight: normal;\">- لا يتحمل موقع Textileforum.net أي مسؤولية عن أي معاملة تجارية أو عملية شراء تتم على المنصة.</span></p><p><span style=\"font-weight: normal;\">- تقع مسؤولية جميع المعاملات التي تتم بين المستخدمين على عاتق الأطراف المعنية.</span></p><p><span style=\"font-weight: normal;\">- لا يضمن «Textile Forum» صحة المعلومات التي يدخلها المستخدمون ولا يمكن تحميله أي مسؤولية عن محتوى الإعلانات بأي شكل من الأشكال.</span></p><p><span style=\"font-weight: normal;\">- النزاعات التي تنشأ عبر المنصة هي بين المستخدمين أنفسهم تمامًا، ولا يقع على عاتق Textile Forum أي التزام بالتدخل في مثل هذه النزاعات.</span></p><p><span style=\"font-weight: normal;\">- يقبل المستخدمون بأن جميع التفاعلات التي يقومون بها على المنصة تتم على مسؤوليتهم الخاصة.</span></p><p><br></p><p>4. التزامات المستخدمين</p><p><span style=\"font-weight: normal;\">- يوافق المستخدمون على استخدام المنصة وفقًا للقوانين.</span></p><p><span style=\"font-weight: normal;\">- يتحمل المستخدمون مسؤولية تقديم معلومات صحيحة وكاملة في الإعلانات التي ينشرونها.</span></p><p><span style=\"font-weight: normal;\">- يتعهد المستخدمون بعدم إساءة استخدام المنصة.</span></p><p><span style=\"font-weight: normal;\">- يُحظر تمامًا القيام بأي أنشطة تسيء إلى قيمة العلامة التجارية لـ Textile Forum أو تكون مضللة أو تهدف إلى الاحتيال.</span></p><p><br></p><p>5. العضوية وأمن الحساب</p><p><span style=\"font-weight: normal;\">- يتحمل المستخدمون مسؤولية صحة المعلومات التي يقدمونها عند التسجيل في Textile Forum.</span></p><p><span style=\"font-weight: normal;\">- كل مستخدم مسؤول عن أمن حسابه. يجب ألا تسمح لأي طرف ثالث باستخدام حسابك.</span></p><p><span style=\"font-weight: normal;\">- إذا كنت تعتقد أن أمن حسابك معرض للخطر، فيجب عليك الاتصال بـ Textile Forum على الفور.</span></p><p><br></p><p>6. سياسة المحتوى</p><p><span style=\"font-weight: normal;\">- لا يجوز للمستخدمين مشاركة محتويات مخالفة للقوانين أو مضللة أو مخالفة للأخلاق في إعلاناتهم.</span></p><p><span style=\"font-weight: normal;\">- يحتفظ منتدى Textile Forum بالحق في مراجعة المحتوى المنشور على المنصة وإزالته عند الضرورة.</span></p><p><span style=\"font-weight: normal;\">- قد يتم تعليق حسابات المستخدمين الذين ينشرون إعلانات مضللة أو تهدف إلى الاحتيال على المنصة، أو حذفها تمامًا.</span></p><p><br></p><p>7. روابط الجهات الخارجية</p><p><span style=\"font-weight: normal;\">قد يوفر «Textile Forum» روابط لمواقع إلكترونية تابعة لأطراف ثالثة على المنصة. ومع ذلك، لا يتحمل «Textile Forum» أي مسؤولية عن محتوى هذه الروابط أو أمانها. ويقوم المستخدمون بزيارة مواقع الأطراف الثالثة على مسؤوليتهم الخاصة.</span></p><p><br></p><p>8. تحديث الشروط</p><p><span style=\"font-weight: normal;\">قد يتم تحديث هذه الشروط والأحكام من وقت لآخر من قِبل Textile Forum. يتعين على المستخدمين متابعة التحديثات التي يتم إجراؤها. تعتبر الشروط المحدثة سارية المفعول اعتبارًا من تاريخ نشرها على المنصة.</span></p><p><br></p><p>9. الاتصال</p><p><span style=\"font-weight: normal;\">إذا كانت لديكم أي أسئلة بخصوص هذه الشروط والأحكام، يمكنكم التواصل معنا عبر البريد الإلكتروني info@textileforum.net.</span></p><p><span style=\"font-weight: normal;\"><br></span></p><p><span style=\"font-weight: normal;\">يهدف Textile Forum إلى توفير منصة آمنة وفعالة للمستخدمين. ومع ذلك، تقع مسؤولية جميع المعاملات على عاتق المستخدمين أنفسهم. نوصيكم باستخدام منصتنا بطريقة واعية وآمنة.</span></p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p><p>\r\n</p>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </section>','2026-08-19 09:43:39','2026-08-19 09:43:39'),(3422,'fe212eb6da94dc3f533495821a91e31b','AR','    <section class=\"text-editor-area\" data-padding-top=\"53\" data-padding-bottom=\"63\">\r\n        <div class=\"container-1440\">\r\n            <div class=\"row\">\r\n                <div class=\"col-lg-12\">\r\n                     <p>سياسة الخصوصية - Textile Forum</p><p><br></p><p><span style=\"font-weight: normal;\">نحن، كفريق Textile Forum، نأخذ خصوصيتك على محمل الجد. توضح هذه السياسة المعلومات التي نجمعها ونعالجها ونستخدمها أثناء استخدامك لموقع Textileforum.net. باستخدامك لمنصتنا، فإنك تُعتبر موافقًا على هذه السياسة.</span></p><p><br></p><p>1. المعلومات التي نجمعها وأغراض استخدامها</p><p><span style=\"font-weight: normal;\">نقوم بجمع بعض المعلومات لنشر إعلانات على Textile Forum والتواصل مع الأعضاء الآخرين:</span></p><p><span style=\"font-weight: normal;\"><br></span></p><p>المعلومات الشخصية:<span style=\"font-weight: normal;\"> المعلومات الأساسية مثل الاسم واللقب وعنوان البريد الإلكتروني ورقم الهاتف.</span></p><p>معلومات الإعلانات:<span style=\"font-weight: normal;\"> الوصف والصور وتفاصيل الاتصال التي تشاركها في إعلاناتك.</span></p><p>معلومات الحساب:<span style=\"font-weight: normal;\"> المعلومات اللازمة لإدارة الحساب، مثل اسم المستخدم وكلمة المرور.</span></p><p>البيانات الفنية:<span style=\"font-weight: normal;\"> التفاصيل الفنية مثل عنوان IP الخاص بك، والمتصفح الذي تستخدمه، وأوقات دخولك إلى الموقع.</span></p><p><br></p><p><span style=\"font-weight: normal;\">تُستخدم هذه المعلومات لتحسين تجربة استخدامك للمنصة، وضمان الأمان، ورفع جودة خدمات Textile Forum.</span></p><p><br></p><p>2. مشاركة المعلومات وظهورها</p><p><span style=\"font-weight: normal;\">يمكن للمستخدمين الآخرين على المنصة رؤية المعلومات التي تشاركها في إعلاناتك. على سبيل المثال، إذا أضفت رقم هاتفك أو عنوان بريدك الإلكتروني، فيمكن للمستخدمين الآخرين الوصول إلى هذه المعلومات. طريقة مشاركة معلوماتك متروكة لك، لكننا ننصحك بتوخي الحذر في هذا الشأن. قد نشارك معلوماتك بناءً على طلب السلطات الرسمية، وفقًا للمتطلبات القانونية.</span></p><p><br></p><p>3. أمن البيانات</p><p><span style=\"font-weight: 400;\">نبذل قصارى جهدنا لضمان أمن معلومات المستخدمين. وعلى وجه الخصوص، لا يتم تخزين كلمات مرور حساباتكم أبدًا في أنظمتنا في شكل نص عادي (قابل للقراءة). يتم حماية كلمات مرورك باستخدام أقوى خوارزميات التشفير (هاش) وفقًا لمعايير القطاع؛ وبذلك لا يمكن لأي شخص، بما في ذلك مسؤولو النظام، الاطلاع على كلمة مرورك. ومع ذلك، نود تذكيرك بأن مشاركة البيانات عبر الإنترنت ليست آمنة تمامًا. تذكر أن المعلومات التي تشاركها عند إنشاء إعلاناتك قد تكون متاحة للجميع.<br><br></span></p><p>4. ملفات تعريف الارتباط وتقنيات التتبع</p><p><span style=\"font-weight: normal;\">يستخدم موقع Textileforum.net ملفات تعريف الارتباط لتقديم تجربة أفضل لكم. </span></p><p>ملفات تعريف الارتباط:</p><p><span style=\"font-weight: normal;\">تحافظ على معلومات جلستك.</span></p><p><span style=\"font-weight: normal;\">تتذكر تفضيلاتك الشخصية.</span></p><p><span style=\"font-weight: normal;\">تحلل استخدام المنصة.</span></p><p><br></p><p><span style=\"font-weight: normal;\">يمكنك تغيير إعدادات ملفات تعريف الارتباط من متصفحك، ولكن بعض الخدمات تعتمد على تفعيل ملفات تعريف الارتباط.</span></p><p><br></p><p>5. حقوق المستخدم</p><p>يمكنك القيام بما يلي في منتدى Textile:</p><p><span style=\"font-weight: normal;\">عرض معلومات حسابك أو تعديلها أو حذفها.</span></p><p><span style=\"font-weight: normal;\">يمكنك تحديث إعلاناتك أو إزالتها.</span></p><p><span style=\"font-weight: normal;\">يمكنك طلب معلومات حول كيفية استخدام بياناتك الشخصية.</span></p><p><span style=\"font-weight: normal;\"><br></span></p><p><span style=\"font-weight: normal;\">لطرح أي أسئلة تتعلق بالخصوصية أو أمن البيانات، يمكنك التواصل معنا عبر البريد الإلكتروني info@textileforum.net.</span></p><p><br></p><p>6. تحديثات السياسة</p><p><span style=\"font-weight: normal;\">قد تتغير سياسة الخصوصية الخاصة بنا بمرور الوقت. تقع على عاتقك مسؤولية متابعة التحديثات. تدخل السياسة المحدثة حيز التنفيذ فور نشرها على موقع Textileforum.net.</span></p><p><br></p><p><span style=\"font-weight: normal;\">نحن في Textile Forum نسعى إلى توفير بيئة تجارية آمنة وشفافة. ونشجعكم على أن تكونوا على دراية بكيفية مشاركة معلوماتكم.</span></p>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </section>','2026-08-19 11:31:53','2026-08-19 11:31:53'),(3423,'3547f154a9d0bbdb6a7dad0606c2e4fb','AR','    <section class=\"text-editor-area\" data-padding-top=\"51\" data-padding-bottom=\"59\">\r\n        <div class=\"container-1440\">\r\n            <div class=\"row\">\r\n                <div class=\"col-lg-12\">\r\n                     <p>نص الإيضاح الخاص بقانون حماية البيانات الشخصية (KVKK)</p><p><br></p><p>1. مقدمة</p><p><span style=\"font-weight: normal;\">بصفتنا منتدى Textile Forum، نولي أهمية كبيرة لحماية البيانات الشخصية لمستخدمينا في إطار قانون حماية البيانات الشخصية رقم 6698 (&quot;KVKK&quot;). وقد أُعد هذا النص بهدف توضيح الأغراض التي تُعالج من أجلها البيانات الشخصية للأشخاص الذين يستخدمون منصة Textileforum.net، وكيفية تخزينها، وطرق حمايتها.</span></p><p><br></p><p>2. أغراض معالجة البيانات الشخصية</p><p><span style=\"font-weight: normal;\">تُعالج البيانات الشخصية التي نجمعها من مستخدمينا للأغراض التالية:</span></p><p><br></p><p><span style=\"font-weight: normal;\">- إنشاء العضوية وإدارتها،</span></p><p><span style=\"font-weight: normal;\">- تقديم خدمة نشر الإعلانات للمستخدمين،</span></p><p><span style=\"font-weight: normal;\">- تيسير التواصل بين المستخدمين،</span></p><p><span style=\"font-weight: normal;\">- تعزيز أمن المنصة ومنع الاحتيال،</span></p><p><span style=\"font-weight: normal;\">- إجراء تحليلات وإحصائيات لتحسين تجربة المستخدم،</span></p><p><span style=\"font-weight: normal;\">- استخدام البيانات في الأنشطة التسويقية في حالة الحصول على موافقة صريحة لإرسال رسائل إلكترونية تجارية،</span></p><p><span style=\"font-weight: normal;\">- الوفاء بالالتزامات القانونية.</span></p><p><br></p><p>3. البيانات الشخصية التي يتم معالجتها</p><p><span style=\"font-weight: normal;\">البيانات الشخصية التي تتم معالجتها على منصتنا هي كما يلي:</span></p><p><br></p><p><span style=\"font-weight: normal;\">- معلومات الهوية: الاسم، اللقب</span></p><p><span style=\"font-weight: normal;\">- معلومات الاتصال: رقم الهاتف، عنوان البريد الإلكتروني</span></p><p><span style=\"font-weight: normal;\">- معلومات الحساب: اسم المستخدم، كلمة المرور</span></p><p><span style=\"font-weight: normal;\">- معلومات الإعلانات: المحتويات التي يضيفها المستخدم (الصور، الوصف، إلخ)</span></p><p><span style=\"font-weight: normal;\">- البيانات التقنية: عنوان IP، معلومات الجهاز، ملفات تعريف الارتباط</span></p><p><br></p><p><span style=\"font-weight: normal;\">يوافق المستخدمون، عند نشر إعلان، على أن معلومات الاتصال الخاصة بهم (رقم الهاتف، البريد الإلكتروني، وما إلى ذلك) قد تكون مرئية للمستخدمين الآخرين.</span></p><p><br></p><p>4. طريقة جمع البيانات الشخصية والأساس القانوني</p><p><span style=\"font-weight: normal;\">يتم جمع البيانات الشخصية بطرق آلية أو يدوية أثناء انضمام المستخدمين إلى Textileforum.net أو نشرهم لإعلانات أو استخدامهم للمنصة. وتُجرى هذه العمليات استنادًا إلى الأسباب القانونية التالية المنصوص عليها في المادتين 5 و6 من قانون حماية البيانات الشخصية:</span></p><p><span style=\"font-weight: normal;\"><br></span></p><p><span style=\"font-weight: normal;\">- النص الصريح على ذلك في القوانين،</span></p><p><span style=\"font-weight: normal;\">- ضرورة إبرام عقد أو تنفيذه،</span></p><p><span style=\"font-weight: normal;\">- الوفاء بالتزاماتنا القانونية،</span></p><p><span style=\"font-weight: normal;\">- الحصول على الموافقة الصريحة للشخص المعني.</span></p><p><br></p><p>5. مدة الاحتفاظ بالبيانات الشخصية</p><p><span style=\"font-weight: normal;\">يتم الاحتفاظ بالبيانات الشخصية طوال المدة اللازمة لتحقيق الغرض من معالجتها. وعند انتهاء مدة الاحتفاظ، يتم حذف البيانات المعنية أو إتلافها أو جعلها مجهولة الهوية وفقًا لأحكام قانون حماية البيانات الشخصية (KVKK) والتشريعات الأخرى ذات الصلة.</span></p><p><br></p><p>6. مشاركة البيانات الشخصية مع أطراف ثالثة</p><p><span style=\"font-weight: normal;\">لا تشارك «Textile Forum» البيانات الشخصية لمستخدميها مع أطراف ثالثة إلا في الحالات التالية:</span></p><p><span style=\"font-weight: normal;\"><br></span></p><p><span style=\"font-weight: normal;\">- مع الجهات الرسمية لغرض الوفاء بالالتزامات القانونية،</span></p><p><span style=\"font-weight: normal;\">- مع الشركاء التجاريين في حالة وجود موافقة صريحة من المستخدمين،</span></p><p><span style=\"font-weight: normal;\">- مع مزودي الخدمات الذين يقدمون خدمات البنية التحتية والخدمات التقنية.</span></p><p><br></p><p><span style=\"font-weight: normal;\">لا يبيع Textile Forum البيانات الشخصية للمستخدمين إلى أطراف ثالثة لأغراض تسويقية أو تجارية.</span></p><p><br></p><p>7. حقوق المستخدمين</p><p><span style=\"font-weight: normal;\">يتمتع المستخدمون بالحقوق التالية بموجب قانون حماية البيانات الشخصية (KVKK):</span></p><p><span style=\"font-weight: normal;\"><br></span></p><p><span style=\"font-weight: normal;\">- معرفة ما إذا كانت بياناتهم الشخصية قد تمت معالجتها أم لا،</span></p><p><span style=\"font-weight: normal;\">- طلب معلومات عن ذلك في حالة معالجتها،</span></p><p><span style=\"font-weight: normal;\">- طلب تصحيح البيانات الشخصية في حالة وجود نقص أو خطأ في معالجتها،</span></p><p><span style=\"font-weight: normal;\">- طلب حذف أو إتلاف البيانات التي تمت معالجتها،</span></p><p><span style=\"font-weight: normal;\">- طلب إخطاره بتصحيح أو حذف البيانات في حالة مشاركتها مع أطراف ثالثة،</span></p><p><span style=\"font-weight: normal;\">- الاعتراض على البيانات التي يتم تحليلها عبر الأنظمة الآلية،</span></p><p><span style=\"font-weight: normal;\">- المطالبة بالتعويض في حالة التعرض لضرر نتيجة معالجة البيانات الشخصية بشكل مخالف للقانون.</span></p><p><span style=\"font-weight: normal;\"><br></span></p><p><span style=\"font-weight: normal;\">يمكن للمستخدمين الراغبين في ممارسة هذه الحقوق التقدم بطلب إلى Textile Forum عبر العنوان *info@textileforum.net*.</span></p><p><br></p><p>8. تدابير الأمان</p><p><span style=\"font-weight: normal;\">يتخذ Textile Forum التدابير الفنية والإدارية المناسبة لضمان سرية وأمن البيانات الشخصية. ومع ذلك، يجب ألا يُنسى أنه لا توجد ضمانة كاملة لأمن عمليات نقل البيانات عبر الإنترنت.</span></p><p><br></p><p>9. تحديث نص قانون حماية البيانات الشخصية</p><p><span style=\"font-weight: normal;\">قد يتم تحديث نص إخطار سياسة حماية البيانات الشخصية هذا في حالة حدوث تغييرات في التشريعات أو في سياسات معالجة البيانات الخاصة بـ Textile Forum. ويُعتبر النص المحدث ساري المفعول اعتبارًا من تاريخ نشره على المنصة.</span></p><p><br></p><p>الاتصال:</p><p><span style=\"font-weight: normal;\">يمكنكم التواصل معنا عبر البريد الإلكتروني info@textileforum.net في حال وجود أي استفسارات أو طلبات تتعلق بقانون حماية البيانات الشخصية.</span></p><p><span style=\"font-weight: normal;\"><br></span></p><p><span style=\"font-weight: normal;\">نحن في Textile Forum نولي أهمية كبيرة لأمن بياناتكم الشخصية، ونلتزم بتقديم خدمة شفافة وموثوقة.</span></p>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </section>','2026-08-19 11:31:56','2026-08-19 11:31:56');
