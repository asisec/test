:\"on\",\"category_on_off\":\"on\",\"subcategory_on_off\":\"on\",\"child_category_on_off\":\"on\",\"rating_on_off\":\"on\",\"sort_by_on_off\":\"on\",\"date_posted\":\"on\",\"listing_condition\":\"on\",\"listing_type_preferences\":\"on\",\"country\":\"\\u00dclke\",\"state\":\"B\\u00f6lge\",\"city\":\"\\u015eehir\",\"listing_search_by_text\":\"\\u0130lan Ara\",\"category\":\"Kategori\",\"subcategory\":\"Alt Kategori\",\"child_category\":\"\\u00c7ocuk Kategorisi\",\"listing_type_preferences_title\":\"\\u00c7e\\u015fitler\",\"listing_condition_title\":\"Durum\",\"date_posted_title\":\"Payla\\u015f\\u0131ld\\u0131\\u011f\\u0131 Tarih\",\"google_map_maker_icon\":\"316\"}','2024-04-18 07:07:44','2026-06-08 00:46:17'),(22,'BlogTipsOne','update','Modules\\Blog\\app\\Http\\PageBuilder\\Addons\\BlogTipsOne','dynamic_page',3,15,'dynamic_page','{\"id\":\"22\",\"addon_name\":\"BlogTipsOne\",\"addon_namespace\":\"TW9kdWxlc1xCbG9nXGFwcFxIdHRwXFBhZ2VCdWlsZGVyXEFkZG9uc1xCbG9nVGlwc09uZQ==\",\"addon_type\":\"update\",\"addon_location\":\"dynamic_page\",\"addon_order\":\"3\",\"addon_page_id\":\"15\",\"addon_page_type\":\"dynamic_page\",\"title\":\"10 Tips to maintain consistency in your campaign\",\"button_title\":\"Read Now\",\"button_link\":\"https:\\/\\/listocean.bytesed.com\\/tips-to-maintain-consistency\",\"blog_tips_image\":\"381\",\"section_bg\":\"rgb(255, 255, 255)\",\"padding_top\":\"50\",\"padding_bottom\":\"50\"}','2024-05-06 00:35:17','2024-06-27 12:31:13'),(23,'AllBlog','update','Modules\\Blog\\app\\Http\\PageBuilder\\Addons\\AllBlog','dynamic_page',4,15,'dynamic_page','{\"id\":\"23\",\"addon_name\":\"AllBlog\",\"addon_namespace\":\"TW9kdWxlc1xCbG9nXGFwcFxIdHRwXFBhZ2VCdWlsZGVyXEFkZG9uc1xBbGxCbG9n\",\"addon_type\":\"update\",\"addon_location\":\"dynamic_page\",\"addon_order\":\"4\",\"addon_page_id\":\"15\",\"addon_page_type\":\"dynamic_page\",\"title\":\"Daily Blogs\",\"order_by\":\"id\",\"order\":\"asc\",\"items\":\"10\",\"section_bg\":null,\"padding_top\":\"50\",\"padding_bottom\":\"100\"}','2024-05-06 01:46:02','2024-06-27 12:30:58'),(24,'Faq','update','plugins\\PageBuilder\\Addons\\Faq\\Faq','dynamic_page',1,2,'dynamic_page','{\"id\":\"24\",\"addon_name\":\"Faq\",\"addon_namespace\":\"cGx1Z2luc1xQYWdlQnVpbGRlclxBZGRvbnNcRmFxXEZhcQ==\",\"addon_type\":\"update\",\"addon_location\":\"dynamic_page\",\"addon_order\":\"1\",\"addon_page_id\":\"2\",\"addon_page_type\":\"dynamic_page\",\"padding_top\":\"83\",\"padding_bottom\":\"73\",\"section_bg\":\"rgb(172, 172, 172)\",\"contact_page_contact_info_01\":{\"title_\":[\"fsdfs\",\"fsdfsfsdfsd\"],\"description_\":[\"dfsdfsd\",\"dfsdfsdf\"]}}','2024-05-07 03:54:24','2024-05-07 03:54:25'),(26,'FaqOne','update','plugins\\PageBuilder\\Addons\\Faq\\FaqOne','dynamic_page',1,7,'dynamic_page','{\"id\":\"26\",\"addon_name\":\"FaqOne\",\"addon_namespace\":\"cGx1Z2luc1xQYWdlQnVpbGRlclxBZGRvbnNcRmFxXEZhcU9uZQ==\",\"addon_type\":\"update\",\"addon_location\":\"dynamic_page\",\"addon_order\":\"1\",\"addon_page_id\":\"7\",\"addon_page_type\":\"dynamic_page\",\"title\":\"Frequently Asked Questions\",\"contact_info\":\"Didn\\u2019t find the right answer? here you can ask your own questions to our support\",\"contact_info_title\":\"Contact us\",\"contact_info_link\":\"https:\\/\\/listocean.bytesed.com\\/contact\",\"contact_page_contact_info_01\":{\"title_\":[\"User Registration and Authentication\",\"Listing Management\",\"Search and Filter\",\"Payment Integration\",\"Messaging System\",\"User Reviews and Ratings\",\"Responsive Design:\"],\"description_\":[\"Allow users to create accounts and login securely. This will enable them to manage their listings, save favorite listings, and receive notifications.\",\"Provide a user-friendly interface for creating, editing, and deleting listings. Each listing should include details such as title, description, price, category, location, contact information, and optional images.\",\"Implement robust search and filter options to help users find relevant listings quickly. Users should be able to filter by category, location, price range, date posted, and other relevant criteria.\",\"If you plan to monetize your website, integrate payment gateways to facilitate transactions between buyers and sellers. This could include options for one-time payments, subscriptions, or featured listings.\",\"Enable communication between buyers and sellers through an internal messaging system. This will allow users to ask questions, negotiate prices, and arrange meetings securely.\",\"Implement a system for users to leave reviews and ratings for sellers and their listings. This will help build trust and credibility within your community.\",\"Ensure your website is optimized for various devices, including desktops, laptops, tablets, and smartphones. A responsive design will provide a seamless user experience across all devices.\"]},\"section_bg\":null,\"padding_top\":\"50\",\"padding_bottom\":\"100\"}','2024-05-07 04:12:52','2024-06-27 12:30:00'),(27,'TextEditor','update','plugins\\PageBuilder\\Addons\\Common\\TextEditor','dynamic_page',1,5,'dynamic_page','{\"id\":\"27\",\"addon_name\":\"TextEditor\",\"addon_namespace\":\"cGx1Z2luc1xQYWdlQnVpbGRlclxBZGRvbnNcQ29tbW9uXFRleHRFZGl0b3I=\",\"addon_type\":\"update\",\"addon_location\":\"dynamic_page\",\"addon_order\":\"1\",\"addon_page_id\":\"5\",\"addon_page_type\":\"dynamic_page\",\"text_editor\":\"<p><span style=\\\"color: var(--paragraph-color); text-align: var(--bs-body-text-align);\\\">\\u015eartlar ve Ko\\u015fullar - Textile Forum<\\/span><\\/p><p><br><\\/p><p>1. Giri\\u015f<\\/p><p><span style=\\\"font-weight: normal;\\\">Bu \\u015eartlar ve Ko\\u015fullar, Textileforum.net (bundan sonra \\\"platform\\\" olarak an\\u0131lacakt\\u0131r) hizmetlerini kullanan t\\u00fcm kullan\\u0131c\\u0131lar i\\u00e7in ge\\u00e7erlidir. Platformu kullanarak, a\\u015fa\\u011f\\u0131daki \\u015fartlar\\u0131 kabul etmi\\u015f olursunuz. E\\u011fer bu \\u015fartlar\\u0131 kabul etmiyorsan\\u0131z, platformu kullanmaktan ka\\u00e7\\u0131nmal\\u0131s\\u0131n\\u0131z.<\\/span><\\/p><p><br><\\/p><p>2. Hizmetin Tan\\u0131m\\u0131<\\/p><p><span style=\\\"font-weight: normal;\\\">Textile Forum, tekstil sekt\\u00f6r\\u00fc i\\u00e7in bir ilan ve ileti\\u015fim platformudur. Kullan\\u0131c\\u0131lar, tekstil \\u00fcr\\u00fcnlerini satmak, sat\\u0131n almak veya tedarik\\u00e7i bulmak amac\\u0131yla platformda ilanlar yay\\u0131nlayabilirler. Textile Forum, yaln\\u0131zca bir arac\\u0131d\\u0131r ve hi\\u00e7bir \\u015fekilde ticari i\\u015flemlerin taraf\\u0131 de\\u011fildir.<\\/span><\\/p><p><br><\\/p><p>3. Sorumluluk Reddi<\\/p><p><span style=\\\"font-weight: normal;\\\">- Textileforum.net, platformda ger\\u00e7ekle\\u015ftirilen hi\\u00e7bir ticari i\\u015flemden veya al\\u0131\\u015fveri\\u015ften sorumlu de\\u011fildir.<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- Kullan\\u0131c\\u0131lar aras\\u0131nda ger\\u00e7ekle\\u015fen t\\u00fcm i\\u015flemler, taraflar\\u0131n kendi sorumlulu\\u011fundad\\u0131r.<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- Textile Forum, kullan\\u0131c\\u0131lar taraf\\u0131ndan girilen bilgilerin do\\u011frulu\\u011funu garanti etmez ve ilan i\\u00e7eriklerinden hi\\u00e7bir \\u015fekilde sorumlu tutulamaz.<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- Platform \\u00fczerinden yap\\u0131lan anla\\u015fmazl\\u0131klar tamamen kullan\\u0131c\\u0131lar\\u0131n kendi aralar\\u0131ndad\\u0131r ve Textile Forum\'un bu t\\u00fcr anla\\u015fmazl\\u0131klara m\\u00fcdahale etme y\\u00fck\\u00fcml\\u00fcl\\u00fc\\u011f\\u00fc yoktur.<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- Kullan\\u0131c\\u0131lar, platformda ger\\u00e7ekle\\u015ftirdikleri t\\u00fcm etkile\\u015fimlerin kendi riskleri dahilinde oldu\\u011funu kabul eder.<\\/span><\\/p><p><br><\\/p><p>4. Kullan\\u0131c\\u0131 Y\\u00fck\\u00fcml\\u00fcl\\u00fckleri<\\/p><p><span style=\\\"font-weight: normal;\\\">- Kullan\\u0131c\\u0131lar, platformu yasalara uygun \\u015fekilde kullanmay\\u0131 kabul eder.<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- Kullan\\u0131c\\u0131lar, verdikleri ilanlarda do\\u011fru ve eksiksiz bilgi sa\\u011flamakla y\\u00fck\\u00fcml\\u00fcd\\u00fcr.<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- Kullan\\u0131c\\u0131lar, platformu k\\u00f6t\\u00fcye kullanmayacaklar\\u0131n\\u0131 taahh\\u00fct ederler.<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- Textile Forum\'un marka de\\u011ferini zedeleyici, yan\\u0131lt\\u0131c\\u0131 veya doland\\u0131r\\u0131c\\u0131l\\u0131\\u011fa y\\u00f6nelik faaliyetlerde bulunmak kesinlikle yasakt\\u0131r.<\\/span><\\/p><p><br><\\/p><p>5. \\u00dcyelik ve Hesap G\\u00fcvenli\\u011fi<\\/p><p><span style=\\\"font-weight: normal;\\\">- Kullan\\u0131c\\u0131lar, Textile Forum\'a \\u00fcye olurken verdikleri bilgilerin do\\u011frulu\\u011fundan sorumludur.<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- Hesap g\\u00fcvenli\\u011finden her kullan\\u0131c\\u0131 kendisi sorumludur. \\u00dc\\u00e7\\u00fcnc\\u00fc \\u015fah\\u0131slar\\u0131n hesab\\u0131n\\u0131z\\u0131 kullanmas\\u0131na izin vermemelisiniz.<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- Hesab\\u0131n\\u0131z\\u0131n g\\u00fcvenli\\u011finin tehlikeye girdi\\u011fini d\\u00fc\\u015f\\u00fcn\\u00fcyorsan\\u0131z, derhal Textile Forum ile ileti\\u015fime ge\\u00e7melisiniz.<\\/span><\\/p><p><br><\\/p><p>6. \\u0130\\u00e7erik Politikas\\u0131<\\/p><p><span style=\\\"font-weight: normal;\\\">- Kullan\\u0131c\\u0131lar, ilanlar\\u0131nda yasalara ayk\\u0131r\\u0131, yan\\u0131lt\\u0131c\\u0131 veya ahlaka ayk\\u0131r\\u0131 i\\u00e7erikler payla\\u015famaz.<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- Textile Forum, platformda yay\\u0131nlanan i\\u00e7erikleri inceleme ve gerekli g\\u00f6rd\\u00fc\\u011f\\u00fcnde yay\\u0131ndan kald\\u0131rma hakk\\u0131n\\u0131 sakl\\u0131 tutar.<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- Platformda, yan\\u0131lt\\u0131c\\u0131 veya doland\\u0131r\\u0131c\\u0131l\\u0131\\u011fa y\\u00f6nelik ilanlar yay\\u0131nlayan kullan\\u0131c\\u0131lar\\u0131n hesaplar\\u0131 ask\\u0131ya al\\u0131nabilir veya tamamen silinebilir.<\\/span><\\/p><p><br><\\/p><p>7. \\u00dc\\u00e7\\u00fcnc\\u00fc Taraf Ba\\u011flant\\u0131lar<\\/p><p><span style=\\\"font-weight: normal;\\\">Textile Forum, platformda \\u00fc\\u00e7\\u00fcnc\\u00fc taraf web sitelerine ba\\u011flant\\u0131lar sa\\u011flayabilir. Ancak, bu ba\\u011flant\\u0131lar\\u0131n i\\u00e7eri\\u011finden ve g\\u00fcvenli\\u011finden Textile Forum sorumlu de\\u011fildir. Kullan\\u0131c\\u0131lar, \\u00fc\\u00e7\\u00fcnc\\u00fc taraf siteleri kendi riskleri dahilinde ziyaret ederler.<\\/span><\\/p><p><br><\\/p><p>8. \\u015eartlar\\u0131n G\\u00fcncellenmesi<\\/p><p><span style=\\\"font-weight: normal;\\\">Bu \\u015eartlar ve Ko\\u015fullar, Textile Forum taraf\\u0131ndan zaman zaman g\\u00fcncellenebilir. Kullan\\u0131c\\u0131lar, yap\\u0131lan g\\u00fcncellemeleri takip etmekle y\\u00fck\\u00fcml\\u00fcd\\u00fcr. G\\u00fcncellenmi\\u015f \\u015fartlar, platformda yay\\u0131nland\\u0131\\u011f\\u0131 tarihten itibaren ge\\u00e7erli say\\u0131l\\u0131r.<\\/span><\\/p><p><br><\\/p><p>9. \\u0130leti\\u015fim<\\/p><p><span style=\\\"font-weight: normal;\\\">Bu \\u015eartlar ve Ko\\u015fullar hakk\\u0131nda herhangi bir sorunuz varsa, bizimle info@textileforum.net adresinden ileti\\u015fime ge\\u00e7ebilirsiniz.<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\"><br><\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">Textile Forum, kullan\\u0131c\\u0131lara g\\u00fcvenli ve etkili bir platform sunmay\\u0131 hedeflemektedir. Ancak, t\\u00fcm i\\u015flemler kullan\\u0131c\\u0131lar\\u0131n kendi sorumlulu\\u011fundad\\u0131r. Platformumuzu bilin\\u00e7li ve g\\u00fcvenli \\u015fekilde kullanman\\u0131z\\u0131 \\u00f6neririz.<\\/span><\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p>\",\"padding_top\":\"54\",\"padding_bottom\":\"62\"}','2024-05-07 04:53:42','2025-02-06 02:39:06'),(32,'HeaderStyleOne','update','plugins\\PageBuilder\\Addons\\Header\\HeaderStyleOne','dynamic_page',1,3,'dynamic_page','{\"id\":\"32\",\"addon_name\":\"HeaderStyleOne\",\"addon_namespace\":\"cGx1Z2luc1xQYWdlQnVpbGRlclxBZGRvbnNcSGVhZGVyXEhlYWRlclN0eWxlT25l\",\"addon_type\":\"update\",\"addon_location\":\"dynamic_page\",\"addon_order\":\"1\",\"addon_page_id\":\"3\",\"addon_page_type\":\"dynamic_page\",\"title\":\"Global Tekstil ve Kuma\\u015f \\u0130lan Platformu\",\"subtitle\":\"T\\u00fcrkiye\'nin ve d\\u00fcnyan\\u0131n g\\u00fcvenilir tekstil ilan ve ticaret platformu. \\u00dcreticiler, tedarik\\u00e7iler ve al\\u0131c\\u0131larla hemen ileti\\u015fime ge\\u00e7in, ticaret a\\u011f\\u0131n\\u0131z\\u0131 b\\u00fcy\\u00fct\\u00fcn.\",\"top_title\":\"Tekstil D\\u00fcnyas\\u0131n\\u0131n Yeni Bulu\\u015fma Noktas\\u0131\",\"top_image\":null,\"header_background_color\":\"rgb(243, 217, 201)\",\"background_image\":\"569\",\"banner_left_images_01\":{\"banner_left_images_\":[\"397\",\"398\",\"399\"]},\"banner_right_images_02\":{\"banner_right_images_\":[\"400\"]},\"search_button_title\":\"Ara\",\"padding_top\":\"100\",\"padding_bottom\":\"50\"}','2024-05-12 05:33:52','2026-06-12 06:17:33'),(36,'CategoryWiseListing','update','plugins\\PageBuilder\\Addons\\Listing\\CategoryWiseListing','dynamic_page',3,3,'dynamic_page','{\"id\":\"36\",\"addon_name\":\"CategoryWiseListing\",\"addon_namespace\":\"cGx1Z2luc1xQYWdlQnVpbGRlclxBZGRvbnNcTGlzdGluZ1xDYXRlZ29yeVdpc2VMaXN0aW5n\",\"addon_type\":\"update\",\"addon_location\":\"dynamic_page\",\"addon_order\":\"6\",\"addon_page_id\":\"3\",\"addon_page_type\":\"dynamic_page\",\"title\":null,\"explore_all\":\"Hepsini G\\u00f6r\",\"items\":\"10\",\"category_id\":\"40\",\"padding_top\":\"50\",\"padding_bottom\":\"50\",\"section_bg\":null,\"btn_color\":null,\"button_text_color\":null}','2024-06-11 05:42:11','2025-02-06 10:55:56'),(37,'CategoryWiseListing','update','plugins\\PageBuilder\\Addons\\Listing\\CategoryWiseListing','dynamic_page',2,3,'dynamic_page','{\"id\":\"37\",\"addon_name\":\"CategoryWiseListing\",\"addon_namespace\":\"cGx1Z2luc1xQYWdlQnVpbGRlclxBZGRvbnNcTGlzdGluZ1xDYXRlZ29yeVdpc2VMaXN0aW5n\",\"addon_type\":\"update\",\"addon_location\":\"dynamic_page\",\"addon_order\":\"2\",\"addon_page_id\":\"3\",\"addon_page_type\":\"dynamic_page\",\"title\":null,\"explore_all\":\"Hepsini G\\u00f6r\",\"items\":\"5\",\"category_id\":\"38\",\"padding_top\":\"50\",\"padding_bottom\":\"50\",\"section_bg\":null,\"btn_color\":null,\"button_text_color\":null}','2024-06-11 08:43:02','2025-02-24 16:18:33'),(40,'TextEditor','update','plugins\\PageBuilder\\Addons\\Common\\TextEditor','dynamic_page',1,6,'dynamic_page','{\"id\":\"40\",\"addon_name\":\"TextEditor\",\"addon_namespace\":\"cGx1Z2luc1xQYWdlQnVpbGRlclxBZGRvbnNcQ29tbW9uXFRleHRFZGl0b3I=\",\"addon_type\":\"update\",\"addon_location\":\"dynamic_page\",\"addon_order\":\"1\",\"addon_page_id\":\"6\",\"addon_page_type\":\"dynamic_page\",\"text_editor\":\"<p>Gizlilik Politikas\\u0131 - Textile Forum<\\/p><p><br><\\/p><p><span style=\\\"font-weight: normal;\\\">Textile Forum ailesi olarak, sizin gizlili\\u011finizi ciddiye al\\u0131yoruz. Bu politika, Textileforum.net kullan\\u0131rken toplad\\u0131\\u011f\\u0131m\\u0131z, i\\u015fledi\\u011fimiz ve kulland\\u0131\\u011f\\u0131m\\u0131z bilgileri a\\u00e7\\u0131kl\\u0131yor. Platformumuzu kullanarak, bu politikay\\u0131 kabul etmi\\u015f say\\u0131l\\u0131rs\\u0131n\\u0131z.<\\/span><\\/p><p><br><\\/p><p>1. Toplad\\u0131\\u011f\\u0131m\\u0131z Bilgiler ve Kullan\\u0131m Ama\\u00e7lar\\u0131<\\/p><p><span style=\\\"font-weight: normal;\\\">Textile Forum\'da ilan vermek ve di\\u011fer \\u00fcyelerle ileti\\u015fim kurmak i\\u00e7in birtak\\u0131m bilgileri toplar\\u0131z:<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\"><br><\\/span><\\/p><p>Ki\\u015fisel Bilgiler:<span style=\\\"font-weight: normal;\\\"> Ad\\u0131n\\u0131z, soyad\\u0131n\\u0131z, e-posta adresiniz, telefon numaran\\u0131z gibi temel bilgiler.<\\/span><\\/p><p>\\u0130lan Bilgileri:<span style=\\\"font-weight: normal;\\\"> \\u0130lanlar\\u0131n\\u0131zda payla\\u015ft\\u0131\\u011f\\u0131n\\u0131z a\\u00e7\\u0131klamalar, g\\u00f6rseller ve ileti\\u015fim detaylar\\u0131.<\\/span><\\/p><p>Hesap Bilgileri:<span style=\\\"font-weight: normal;\\\"> Kullan\\u0131c\\u0131 ad\\u0131n\\u0131z ve \\u015fifreniz gibi hesap y\\u00f6netimi i\\u00e7in gereken bilgiler.<\\/span><\\/p><p>Teknik Veriler:<span style=\\\"font-weight: normal;\\\"> IP adresiniz, kulland\\u0131\\u011f\\u0131n\\u0131z taray\\u0131c\\u0131 ve siteye eri\\u015fim zamanlar\\u0131 gibi teknik detaylar.<\\/span><\\/p><p><br><\\/p><p><span style=\\\"font-weight: normal;\\\">Bu bilgiler, sizin platformu kullan\\u0131m deneyiminizi iyile\\u015ftirmek, g\\u00fcvenli\\u011fi sa\\u011flamak ve Textile Forum\'un hizmet kalitesini art\\u0131rmak i\\u00e7in kullan\\u0131l\\u0131r.<\\/span><\\/p><p><br><\\/p><p>2. Bilgilerin Payla\\u015f\\u0131m\\u0131 ve G\\u00f6r\\u00fcn\\u00fcrl\\u00fc\\u011f\\u00fc<\\/p><p><span style=\\\"font-weight: normal;\\\">\\u0130lanlar\\u0131n\\u0131zda payla\\u015ft\\u0131\\u011f\\u0131n\\u0131z bilgiler, platformun di\\u011fer kullan\\u0131c\\u0131lar\\u0131 taraf\\u0131ndan g\\u00f6r\\u00fclebilir. \\u00d6rne\\u011fin, telefon numaran\\u0131z\\u0131 veya e-posta adresinizi eklediyseniz, bu bilgilere di\\u011fer kullan\\u0131c\\u0131lar eri\\u015febilir. Bilgilerinizi nas\\u0131l payla\\u015ft\\u0131\\u011f\\u0131n\\u0131z size kalm\\u0131\\u015f, ancak bu konuda dikkatli olman\\u0131z\\u0131 \\u00f6neririz. Resmi makamlar\\u0131n talebi \\u00fczerine, yasal gereklilikler do\\u011frultusunda bilgilerinizi payla\\u015fabiliriz.<\\/span><\\/p><p><br><\\/p><p>3. Veri G\\u00fcvenli\\u011fi<\\/p><p><span style=\\\"font-weight: 400;\\\">Kullan\\u0131c\\u0131 bilgilerinizin g\\u00fcvenli\\u011fini sa\\u011flamak i\\u00e7in elimizden geleni yap\\u0131yoruz. \\u00d6zellikle hesap \\u015fifreleriniz sistemlerimizde asla a\\u00e7\\u0131k metin olarak (okunabilir \\u015fekilde) tutulmaz. \\u015eifreleriniz, sekt\\u00f6r standartlar\\u0131na uygun olarak en g\\u00fc\\u00e7l\\u00fc \\u015fifreleme algoritmalar\\u0131yla (hash) korunur; bu sayede sistem y\\u00f6neticileri dahil kimse \\u015fifrenizi g\\u00f6r\\u00fcnt\\u00fcleyemez. Ancak, internet \\u00fczerinden veri payla\\u015f\\u0131m\\u0131n\\u0131n tamamen g\\u00fcvenli olmad\\u0131\\u011f\\u0131n\\u0131 hat\\u0131rlatmak isteriz. \\u0130lanlar\\u0131n\\u0131z\\u0131 olu\\u015ftururken payla\\u015ft\\u0131\\u011f\\u0131n\\u0131z bilgilerin herkese a\\u00e7\\u0131k olabilece\\u011fini unutmay\\u0131n.<br><br><\\/span><\\/p><p>4. \\u00c7erezler ve \\u0130zleme Teknolojileri<\\/p><p><span style=\\\"font-weight: normal;\\\">Textileforum.net, sizlere daha iyi bir deneyim sunmak i\\u00e7in \\u00e7erezler kullan\\u0131yor. <\\/span><\\/p><p>\\u00c7erezler:<\\/p><p><span style=\\\"font-weight: normal;\\\">Oturum bilgilerinizi korur.<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">Ki\\u015fisel tercihlerinizi hat\\u0131rlar.<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">Platform kullan\\u0131m\\u0131n\\u0131 analiz eder.<\\/span><\\/p><p><br><\\/p><p><span style=\\\"font-weight: normal;\\\">\\u00c7erez ayarlar\\u0131n\\u0131z\\u0131 taray\\u0131c\\u0131n\\u0131zdan de\\u011fi\\u015ftirebilirsiniz, ancak baz\\u0131 hizmetler \\u00e7erezlerin aktifli\\u011fine ba\\u011fl\\u0131d\\u0131r.<\\/span><\\/p><p><br><\\/p><p>5. Kullan\\u0131c\\u0131 Haklar\\u0131<\\/p><p>Textile Forum\'da \\u015funlar\\u0131 yapabilirsiniz:<\\/p><p><span style=\\\"font-weight: normal;\\\">Hesap bilgilerinizi g\\u00f6r\\u00fcnt\\u00fcleyip, de\\u011fi\\u015ftirebilir veya silebilirsiniz.<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">\\u0130lanlar\\u0131n\\u0131z\\u0131 g\\u00fcncelleyebilir veya kald\\u0131rabilirsiniz.<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">Ki\\u015fisel verilerinizin nas\\u0131l kullan\\u0131ld\\u0131\\u011f\\u0131 hakk\\u0131nda bilgi talep edebilirsiniz.<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\"><br><\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">Gizlilik veya veri g\\u00fcvenli\\u011fi ile ilgili sorular\\u0131n\\u0131z i\\u00e7in bize info@textileforum.net \\u00fczerinden ula\\u015fabilirsiniz.<\\/span><\\/p><p><br><\\/p><p>6. Politika G\\u00fcncellemeleri<\\/p><p><span style=\\\"font-weight: normal;\\\">Gizlilik politikam\\u0131z zamanla de\\u011fi\\u015febilir. G\\u00fcncellemeleri takip etmek sizin sorumlulu\\u011funuzda. G\\u00fcncellenmi\\u015f politika, Textileforum.net\'te yay\\u0131nland\\u0131\\u011f\\u0131nda y\\u00fcr\\u00fcrl\\u00fc\\u011fe girer.<\\/span><\\/p><p><br><\\/p><p><span style=\\\"font-weight: normal;\\\">Textile Forum olarak, g\\u00fcvenli ve \\u015feffaf bir ticaret ortam\\u0131 sa\\u011flamay\\u0131 hedefliyoruz. Bilgilerinizi nas\\u0131l payla\\u015faca\\u011f\\u0131n\\u0131z konusunda bilin\\u00e7li olman\\u0131z\\u0131 te\\u015fvik ediyoruz.<\\/span><\\/p>\",\"padding_top\":\"53\",\"padding_bottom\":\"63\"}','2025-02-06 02:36:50','2026-06-12 09:21:30'),(41,'TextEditor','new','plugins\\PageBuilder\\Addons\\Common\\TextEditor','dynamic_page',1,17,'dynamic_page','{\"addon_name\":\"TextEditor\",\"addon_namespace\":\"cGx1Z2luc1xQYWdlQnVpbGRlclxBZGRvbnNcQ29tbW9uXFRleHRFZGl0b3I=\",\"addon_type\":\"new\",\"addon_location\":\"dynamic_page\",\"addon_order\":\"1\",\"addon_page_id\":\"17\",\"addon_page_type\":\"dynamic_page\",\"text_editor\":\"<p>Hakk\\u0131m\\u0131zda - Textile Forum<\\/p><p><span style=\\\"font-weight: normal;\\\">Tekstil Sekt\\u00f6r\\u00fcn\\u00fcn Yenilik\\u00e7i G\\u00fcc\\u00fc<\\/span><\\/p><p><br><\\/p><p><span style=\\\"font-weight: normal;\\\">Textile Forum, tekstil end\\u00fcstrisinde k\\u00f6kl\\u00fc bir de\\u011fi\\u015fim yaratma amac\\u0131yla do\\u011fdu. \\u00dcreticileri, tedarik\\u00e7ileri, perakendecileri ve al\\u0131c\\u0131lar\\u0131 tek bir \\u00e7at\\u0131 alt\\u0131nda toplayarak, sekt\\u00f6r i\\u00e7i ticaretin hem h\\u0131z\\u0131n\\u0131 hem de verimlili\\u011fini art\\u0131rmay\\u0131 hedefliyoruz. Textileforum.net \\u00fczerinden, tekstil sekt\\u00f6r\\u00fcn\\u00fc dijital \\u00e7a\\u011fa ta\\u015f\\u0131yor, al\\u0131m-sat\\u0131m i\\u015flemlerini yeniden tasarl\\u0131yoruz.<\\/span><\\/p><p><br><\\/p><p>Textile Forum Neden Farkl\\u0131?<\\/p><p><span style=\\\"font-weight: normal;\\\">Kolay ve H\\u0131zl\\u0131 Al\\u0131m-Sat\\u0131m: Kullan\\u0131c\\u0131lar\\u0131m\\u0131z, tekstil \\u00fcr\\u00fcnleri ve hizmetlerini kolayl\\u0131kla ilan edebilecekleri, kullan\\u0131c\\u0131 dostu bir platforma sahip. Geli\\u015fmi\\u015f arama ve filtreleme se\\u00e7enekleri sayesinde, tam da arad\\u0131\\u011f\\u0131n\\u0131z \\u00fcr\\u00fcnlere birka\\u00e7 t\\u0131kla ula\\u015fabilirsiniz.<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\"><br><\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">Geni\\u015f \\u00dcr\\u00fcn ve Kategori Yelpazesi: Kuma\\u015ftan tekstil makinelerine, moda aksesuarlar\\u0131ndan ni\\u015f \\u00fcr\\u00fcnlere kadar her t\\u00fcrl\\u00fc tekstil \\u00fcr\\u00fcn\\u00fc i\\u00e7in \\u00f6zel kategorilerimiz var. Her sekt\\u00f6rden i\\u015fletme ve birey i\\u00e7in kapsaml\\u0131 bir \\u00e7\\u00f6z\\u00fcm sunuyoruz.<\\/span><\\/p><p><br><\\/p><p><span style=\\\"font-weight: normal;\\\">G\\u00fcven Odakl\\u0131 Ticareti: Textile Forum, g\\u00fcvenli ve \\u015feffaf bir ticaret ortam\\u0131 sa\\u011flamak i\\u00e7in kullan\\u0131c\\u0131 de\\u011ferlendirme ve yorum sistemlerini kullan\\u0131r. Bu sayede, i\\u015f partnerlerinizin ge\\u00e7mi\\u015f deneyimlerine dair bilgi edinerek daha g\\u00fcvenli i\\u015f ili\\u015fkileri kurabilirsiniz.<\\/span><\\/p><p><br><\\/p><p><span style=\\\"font-weight: normal;\\\">E\\u011fitim ve Bilgi Kayna\\u011f\\u0131: Sadece bir ticaret platformu de\\u011fil, tekstil sekt\\u00f6r\\u00fc hakk\\u0131nda en son haberleri, e\\u011fitim i\\u00e7eriklerini ve trend analizlerini sunan bir bilgi merkeziyiz. Burada, rekabet avantaj\\u0131 kazanmak i\\u00e7in ihtiya\\u00e7 duydu\\u011funuz t\\u00fcm bilgilere ula\\u015fabilirsiniz.<\\/span><\\/p><p><br><\\/p><p><span style=\\\"font-weight: normal;\\\">K\\u00fcresel Pazar Eri\\u015fimi: Uluslararas\\u0131 ticareti kolayla\\u015ft\\u0131rmak i\\u00e7in \\u00e7oklu dil deste\\u011fi, d\\u00f6viz kuru bilgileri ve lojistik rehberleri sunuyoruz. Textile Forum ile d\\u00fcnyan\\u0131n her yerine ula\\u015fabilirsiniz.<\\/span><\\/p><p><br><\\/p><p><span style=\\\"font-weight: normal;\\\">Reklam ve \\u0130\\u015fbirli\\u011fi F\\u0131rsatlar\\u0131: Markan\\u0131z\\u0131 b\\u00fcy\\u00fctmek ve geni\\u015f kitlelere ula\\u015fmak i\\u00e7in \\u00e7e\\u015fitli reklam ve i\\u015fbirli\\u011fi se\\u00e7enekleri sunuyoruz. Stratejik ortakl\\u0131klarla, sizi sekt\\u00f6r\\u00fcn \\u00f6nc\\u00fc isimlerinden biri yapmak i\\u00e7in \\u00e7al\\u0131\\u015f\\u0131yoruz.<\\/span><\\/p><p><br><\\/p><p>Textile Forum ile Dijital D\\u00f6n\\u00fc\\u015f\\u00fcm!<\\/p><p><span style=\\\"font-weight: normal;\\\">Misyonumuz, tekstil sekt\\u00f6r\\u00fcn\\u00fc dijitalle\\u015ftirerek modern ticaretin gereksinimlerine uyum sa\\u011flamak. Textile Forum, kullan\\u0131c\\u0131lar\\u0131na i\\u015flerini b\\u00fcy\\u00fctme, sekt\\u00f6rdeki etkile\\u015fimlerini art\\u0131rma ve yenilik\\u00e7i \\u00e7\\u00f6z\\u00fcmler sunma imkan\\u0131 sa\\u011fl\\u0131yor.<\\/span><\\/p><p><br><\\/p><p><span style=\\\"font-weight: normal;\\\">Gelin, Textile Forum\'un sundu\\u011fu bu ayr\\u0131cal\\u0131klar\\u0131 ke\\u015ffedin ve tekstil ticaretinizi dijital d\\u00fcnyan\\u0131n g\\u00fcc\\u00fcyle bir ad\\u0131m \\u00f6ne ta\\u015f\\u0131y\\u0131n!<\\/span><\\/p><p><br><\\/p><p>Bize Kat\\u0131l\\u0131n ve Textile Forum\'un Ayr\\u0131cal\\u0131klar\\u0131n\\u0131 Ke\\u015ffedin!<\\/p>\",\"padding_top\":\"51\",\"padding_bottom\":\"61\"}','2025-02-06 02:38:32','2025-02-06 02:38:32'),(42,'TextEditor','update','plugins\\PageBuilder\\Addons\\Common\\TextEditor','dynamic_page',1,20,'dynamic_page','{\"id\":\"42\",\"addon_name\":\"TextEditor\",\"addon_namespace\":\"cGx1Z2luc1xQYWdlQnVpbGRlclxBZGRvbnNcQ29tbW9uXFRleHRFZGl0b3I=\",\"addon_type\":\"update\",\"addon_location\":\"dynamic_page\",\"addon_order\":\"1\",\"addon_page_id\":\"20\",\"addon_page_type\":\"dynamic_page\",\"text_editor\":\"<p>Ki\\u015fisel Verilerin Korunmas\\u0131 Kanunu (KVKK) Ayd\\u0131nlatma Metni<\\/p><p><br><\\/p><p>1. Giri\\u015f<\\/p><p><span style=\\\"font-weight: normal;\\\">Textile Forum olarak, 6698 say\\u0131l\\u0131 Ki\\u015fisel Verilerin Korunmas\\u0131 Kanunu (\\u201cKVKK\\u201d) kapsam\\u0131nda, kullan\\u0131c\\u0131lar\\u0131m\\u0131z\\u0131n ki\\u015fisel verilerinin korunmas\\u0131na b\\u00fcy\\u00fck \\u00f6nem vermekteyiz. Bu metin, Textileforum.net platformunu kullanan ki\\u015filerin ki\\u015fisel verilerinin hangi ama\\u00e7larla i\\u015flendi\\u011fini, nas\\u0131l sakland\\u0131\\u011f\\u0131n\\u0131 ve korunma y\\u00f6ntemlerini a\\u00e7\\u0131klamak amac\\u0131yla haz\\u0131rlanm\\u0131\\u015ft\\u0131r.<\\/span><\\/p><p><br><\\/p><p>2. Ki\\u015fisel Verilerin \\u0130\\u015flenme Ama\\u00e7lar\\u0131<\\/p><p><span style=\\\"font-weight: normal;\\\">Kullan\\u0131c\\u0131lar\\u0131m\\u0131zdan toplad\\u0131\\u011f\\u0131m\\u0131z ki\\u015fisel veriler a\\u015fa\\u011f\\u0131daki ama\\u00e7larla i\\u015flenmektedir:<\\/span><\\/p><p><br><\\/p><p><span style=\\\"font-weight: normal;\\\">- \\u00dcyelik olu\\u015fturma ve y\\u00f6netme,<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- Kullan\\u0131c\\u0131lara ilan yay\\u0131nlama hizmeti sunma,<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- Kullan\\u0131c\\u0131lar aras\\u0131 ileti\\u015fimi sa\\u011flama,<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- Platformun g\\u00fcvenli\\u011fini art\\u0131rma ve doland\\u0131r\\u0131c\\u0131l\\u0131\\u011f\\u0131 \\u00f6nleme,<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- Kullan\\u0131c\\u0131 deneyimini geli\\u015ftirmek i\\u00e7in analiz ve istatistik \\u00e7al\\u0131\\u015fmalar\\u0131 yapma,<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- Ticari elektronik ileti g\\u00f6nderimi i\\u00e7in a\\u00e7\\u0131k r\\u0131za al\\u0131nmas\\u0131 halinde pazarlama faaliyetlerinde kullanma,<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- Yasal y\\u00fck\\u00fcml\\u00fcl\\u00fckleri yerine getirme.<\\/span><\\/p><p><br><\\/p><p>3. \\u0130\\u015flenen Ki\\u015fisel Veriler<\\/p><p><span style=\\\"font-weight: normal;\\\">Platformumuzda i\\u015flenen ki\\u015fisel veriler \\u015funlard\\u0131r:<\\/span><\\/p><p><br><\\/p><p><span style=\\\"font-weight: normal;\\\">- Kimlik Bilgileri: Ad, soyad<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- \\u0130leti\\u015fim Bilgileri: Telefon numaras\\u0131, e-posta adresi<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- Hesap Bilgileri: Kullan\\u0131c\\u0131 ad\\u0131, \\u015fifre<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- \\u0130lan Bilgileri: Kullan\\u0131c\\u0131 taraf\\u0131ndan eklenen i\\u00e7erikler (foto\\u011fraf, a\\u00e7\\u0131klamalar vb.)<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- Teknik Veriler: IP adresi, cihaz bilgileri, \\u00e7erezler<\\/span><\\/p><p><br><\\/p><p><span style=\\\"font-weight: normal;\\\">Kullan\\u0131c\\u0131lar, ilan yay\\u0131nlarken ileti\\u015fim bilgilerini (telefon numaras\\u0131, e-posta vb.) payla\\u015ft\\u0131klar\\u0131nda, bu bilgilerin di\\u011fer kullan\\u0131c\\u0131lar taraf\\u0131ndan g\\u00f6r\\u00fcnt\\u00fclenebilece\\u011fini kabul ederler.<\\/span><\\/p><p><br><\\/p><p>4. Ki\\u015fisel Verilerin Toplanma Y\\u00f6ntemi ve Hukuki Sebebi<\\/p><p><span style=\\\"font-weight: normal;\\\">Ki\\u015fisel veriler, kullan\\u0131c\\u0131lar\\u0131n Textileforum.net\\u2019e \\u00fcye olmas\\u0131, ilan vermesi veya platformu kullanmas\\u0131 s\\u0131ras\\u0131nda otomatik ya da manuel yollarla toplanmaktad\\u0131r. Bu i\\u015flemler, KVKK\\u2019n\\u0131n 5. ve 6. maddelerinde belirtilen \\u015fu hukuki sebeplere dayan\\u0131larak ger\\u00e7ekle\\u015ftirilmektedir:<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\"><br><\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- Kanunlarda a\\u00e7\\u0131k\\u00e7a \\u00f6ng\\u00f6r\\u00fclmesi,<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- Bir s\\u00f6zle\\u015fmenin kurulmas\\u0131 veya ifas\\u0131 i\\u00e7in gerekli olmas\\u0131,<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- Hukuki y\\u00fck\\u00fcml\\u00fcl\\u00fc\\u011f\\u00fcm\\u00fcz\\u00fcn yerine getirilmesi,<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- \\u0130lgili ki\\u015finin a\\u00e7\\u0131k r\\u0131zas\\u0131n\\u0131n al\\u0131nmas\\u0131.<\\/span><\\/p><p><br><\\/p><p>5. Ki\\u015fisel Verilerin Saklanma S\\u00fcresi<\\/p><p><span style=\\\"font-weight: normal;\\\">Ki\\u015fisel veriler, i\\u015flenme amac\\u0131 do\\u011frultusunda gerekli olan s\\u00fcre boyunca saklan\\u0131r. Saklama s\\u00fcresi sona erdi\\u011finde, ilgili veriler KVKK ve ilgili di\\u011fer mevzuat h\\u00fck\\u00fcmlerine uygun olarak silinir, yok edilir veya anonim hale getirilir.<\\/span><\\/p><p><br><\\/p><p>6. Ki\\u015fisel Verilerin \\u00dc\\u00e7\\u00fcnc\\u00fc Ki\\u015filerle Payla\\u015f\\u0131m\\u0131<\\/p><p><span style=\\\"font-weight: normal;\\\">Textile Forum, kullan\\u0131c\\u0131lar\\u0131n\\u0131n ki\\u015fisel verilerini \\u00fc\\u00e7\\u00fcnc\\u00fc ki\\u015filerle yaln\\u0131zca a\\u015fa\\u011f\\u0131daki durumlarda payla\\u015f\\u0131r:<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\"><br><\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- Yasal y\\u00fck\\u00fcml\\u00fcl\\u00fcklerin yerine getirilmesi amac\\u0131yla resmi makamlarla,<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- Kullan\\u0131c\\u0131lar\\u0131n a\\u00e7\\u0131k r\\u0131zas\\u0131n\\u0131n bulunmas\\u0131 halinde i\\u015f ortaklar\\u0131yla,<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- Altyap\\u0131 ve teknik hizmetler sunan hizmet sa\\u011flay\\u0131c\\u0131larla.<\\/span><\\/p><p><br><\\/p><p><span style=\\\"font-weight: normal;\\\">Textile Forum, kullan\\u0131c\\u0131lar\\u0131n ki\\u015fisel verilerini \\u00fc\\u00e7\\u00fcnc\\u00fc ki\\u015filere pazarlama veya ticari ama\\u00e7larla satmaz.<\\/span><\\/p><p><br><\\/p><p>7. Kullan\\u0131c\\u0131 Haklar\\u0131<\\/p><p><span style=\\\"font-weight: normal;\\\">KVKK kapsam\\u0131nda kullan\\u0131c\\u0131lar\\u0131n a\\u015fa\\u011f\\u0131daki haklar\\u0131 bulunmaktad\\u0131r:<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\"><br><\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- Ki\\u015fisel verilerinin i\\u015flenip i\\u015flenmedi\\u011fini \\u00f6\\u011frenme,<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- \\u0130\\u015flenmi\\u015fse buna ili\\u015fkin bilgi talep etme,<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- Ki\\u015fisel verilerin eksik veya yanl\\u0131\\u015f i\\u015flenmi\\u015f olmas\\u0131 h\\u00e2linde bunlar\\u0131n d\\u00fczeltilmesini isteme,<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- \\u0130\\u015flenen verilerin silinmesini veya yok edilmesini talep etme,<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- Verilerin \\u00fc\\u00e7\\u00fcnc\\u00fc ki\\u015filerle payla\\u015f\\u0131lm\\u0131\\u015f olmas\\u0131 durumunda bunlar\\u0131n d\\u00fczeltilmesi veya silinmesi konusunda bilgilendirilmesini isteme,<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- Otomatik sistemler arac\\u0131l\\u0131\\u011f\\u0131yla analiz edilen veriler hakk\\u0131nda itiraz etme,<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">- Ki\\u015fisel verilerin kanuna ayk\\u0131r\\u0131 olarak i\\u015flenmesi nedeniyle zarara u\\u011framas\\u0131 h\\u00e2linde tazminat talep etme.<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\"><br><\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">Bu haklar\\u0131n\\u0131 kullanmak isteyen kullan\\u0131c\\u0131lar, *info@textileforum.net* adresinden Textile Forum\\u2019a ba\\u015fvurabilirler.<\\/span><\\/p><p><br><\\/p><p>8. G\\u00fcvenlik \\u00d6nlemleri<\\/p><p><span style=\\\"font-weight: normal;\\\">Textile Forum, ki\\u015fisel verilerin gizlili\\u011fini ve g\\u00fcvenli\\u011fini sa\\u011flamak i\\u00e7in uygun teknik ve idari \\u00f6nlemleri al\\u0131r. Ancak, internet \\u00fczerinden yap\\u0131lan veri iletimlerinin tam g\\u00fcvenlik garantisi olmad\\u0131\\u011f\\u0131 unutulmamal\\u0131d\\u0131r.<\\/span><\\/p><p><br><\\/p><p>9. KVKK Metninin G\\u00fcncellenmesi<\\/p><p><span style=\\\"font-weight: normal;\\\">Bu KVKK ayd\\u0131nlatma metni, mevzuat de\\u011fi\\u015fiklikleri veya Textile Forum\\u2019un veri i\\u015fleme politikalar\\u0131nda de\\u011fi\\u015fiklik olmas\\u0131 durumunda g\\u00fcncellenebilir. G\\u00fcncellenen metin, platform \\u00fczerinden yay\\u0131nland\\u0131\\u011f\\u0131 tarihten itibaren ge\\u00e7erli say\\u0131l\\u0131r.<\\/span><\\/p><p><br><\\/p><p>\\u0130leti\\u015fim:<\\/p><p><span style=\\\"font-weight: normal;\\\">Herhangi bir sorunuz veya KVKK kapsam\\u0131ndaki talepleriniz i\\u00e7in bizimle info@textileforum.net adresinden ileti\\u015fime ge\\u00e7ebilirsiniz.<\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\"><br><\\/span><\\/p><p><span style=\\\"font-weight: normal;\\\">Textile Forum olarak ki\\u015fisel verilerinizin g\\u00fcvenli\\u011fini \\u00f6nemsiyor, \\u015feffaf ve g\\u00fcvenilir bir hizmet sunmay\\u0131 taahh\\u00fct ediyoruz.<\\/span><\\/p>\",\"padding_top\":\"51\",\"padding_bottom\":\"59\"}','2025-02-06 02:43:27','2025-02-06 02:43:30'),(44,'TextEditor','new','plugins\\PageBuilder\\Addons\\Common\\TextEditor','dynamic_page',1,21,'dynamic_page','{\"addon_name\":\"TextEditor\",\"addon_namespace\":\"cGx1Z2luc1xQYWdlQnVpbGRlclxBZGRvbnNcQ29tbW9uXFRleHRFZGl0b3I=\",\"addon_type\":\"new\",\"addon_location\":\"dynamic_page\",\"addon_order\":\"1\",\"addon_page_id\":\"21\",\"addon_page_type\":\"dynamic_page\",\"text_editor\":\"<p>About Us - Textile Forum\\r\\n<\\/p><p>The Innovative Power of the Textile Industry\\r\\n<\\/p><p>Textile Forum was founded with the mission of bringing a revolutionary change to the textile industry. By uniting manufacturers, suppliers, retailers, and buyers under one roof, we aim to enhance both the speed and efficiency of industry trade. Through TextileForum.net, we are ushering the textile sector into the digital age and redefining buying and selling processes.\\r\\n<\\/p><p>What Makes Textile Forum Different?\\r\\n<\\/p><p>* Fast and Easy Buying &amp; Selling: Our user-friendly platform allows members to effortlessly list textile products and services. With advanced search and filtering options, finding exactly what you need is just a few clicks away.\\r\\n<\\/p><p>* Extensive Product &amp; Category Range: From fabrics to textile machinery, fashion accessories to niche products, we offer specialized categories for every sector. Our platform provides a comprehensive solution for businesses and individuals alike.\\r\\n<\\/p><p>* Trust-Centered Trade: Textile Forum ensures a secure and transparent business environment through user reviews and rating systems. This allows you to gain insights into potential business partners and build safer commercial relationships.\\r\\n<\\/p><p>* Education &amp; Information Hub: More than just a trading platform, we offer the latest industry news, educational content, and trend analyses. Here, you can access all the information you need to gain a competitive advantage.\\r\\n<\\/p><p>* Global Market Access: We simplify international trade with multilingual support, currency exchange updates, and logistics guidance. With Textile Forum, you can reach markets worldwide.\\r\\n<\\/p><p>* Advertising &amp; Collaboration Opportunities: Expand your brand\\u2019s reach with various advertising and partnership opportunities. Through strategic collaborations, we work to position you among the leading names in the industry.\\r\\n<\\/p><p>Digital Transformation with Textile Forum!\\r\\n<\\/p><p>Our mission is to digitize the textile industry and align it with the needs of modern commerce. Textile Forum empowers its users to grow their businesses, expand industry connections, and leverage innovative solutions.\\r\\n<\\/p><p>Join us today and experience the exclusive benefits of Textile Forum. Take your textile trade to the next level with the power of the&nbsp;digital&nbsp;world!<\\/p>\",\"padding_top\":\"20\",\"padding_bottom\":\"20\"}','2025-04-02 16:38:54','2025-04-02 16:38:54'),(45,'TextEditor','update','plugins\\PageBuilder\\Addons\\Common\\TextEditor','dynamic_page',1,22,'dynamic_page','{\"id\":\"45\",\"addon_name\":\"TextEditor\",\"addon_namespace\":\"cGx1Z2luc1xQYWdlQnVpbGRlclxBZGRvbnNcQ29tbW9uXFRleHRFZGl0b3I=\",\"addon_type\":\"update\",\"addon_location\":\"dynamic_page\",\"addon_order\":\"1\",\"addon_page_id\":\"22\",\"addon_page_type\":\"dynamic_page\",\"text_editor\":\"<p>\\u7eba\\u7ec7\\u884c\\u4e1a\\u7684\\u521b\\u65b0\\u529b\\u91cf\\r\\n<\\/p><p>Textile Forum \\u8bde\\u751f\\u4e8e\\u63a8\\u52a8\\u7eba\\u7ec7\\u884c\\u4e1a\\u53d8\\u9769\\u7684\\u4f7f\\u547d\\u3002\\u6211\\u4eec\\u6c47\\u805a\\u5236\\u9020\\u5546\\u3001\\u4f9b\\u5e94\\u5546\\u3001\\u96f6\\u552e\\u5546\\u548c\\u4e70\\u5bb6\\uff0c\\u63d0\\u5347\\u884c\\u4e1a\\u8d38\\u6613\\u7684\\u901f\\u5ea6\\u548c\\u6548\\u7387\\u3002\\u901a\\u8fc7 TextileForum.net\\uff0c\\u6211\\u4eec\\u5c06\\u7eba\\u7ec7\\u884c\\u4e1a\\u5e26\\u5165\\u6570\\u5b57\\u65f6\\u4ee3\\uff0c\\u91cd\\u65b0\\u5b9a\\u4e49\\u4ea4\\u6613\\u65b9\\u5f0f\\u3002\\r\\n<\\/p><p>Textile Forum \\u6709\\u4f55\\u4e0d\\u540c\\uff1f\\r\\n<\\/p><p>* \\u5feb\\u6377\\u65b9\\u4fbf\\u7684\\u4e70\\u5356\\u6d41\\u7a0b\\uff1a \\u7528\\u6237\\u53ef\\u8f7b\\u677e\\u53d1\\u5e03\\u7eba\\u7ec7\\u4ea7\\u54c1\\u548c\\u670d\\u52a1\\u4fe1\\u606f\\u3002\\u901a\\u8fc7\\u9ad8\\u7ea7\\u641c\\u7d22\\u548c\\u7b5b\\u9009\\u529f\\u80fd\\uff0c\\u5feb\\u901f\\u627e\\u5230\\u6240\\u9700\\u5546\\u54c1\\u3002\\r\\n<\\/p><p>* \\u4e30\\u5bcc\\u7684\\u4ea7\\u54c1\\u4e0e\\u7c7b\\u522b\\uff1a \\u4ece\\u9762\\u6599\\u5230\\u7eba\\u7ec7\\u673a\\u68b0\\uff0c\\u4ece\\u65f6\\u5c1a\\u914d\\u4ef6\\u5230\\u7279\\u79cd\\u4ea7\\u54c1\\uff0c\\u6211\\u4eec\\u4e3a\\u5404\\u7c7b\\u7eba\\u7ec7\\u54c1\\u63d0\\u4f9b\\u4e13\\u5c5e\\u5206\\u7c7b\\uff0c\\u6ee1\\u8db3\\u4e0d\\u540c\\u4f01\\u4e1a\\u548c\\u4e2a\\u4eba\\u7684\\u9700\\u6c42\\u3002\\r\\n<\\/p><p>* \\u5b89\\u5168\\u900f\\u660e\\u7684\\u4ea4\\u6613\\uff1a Textile Forum \\u91c7\\u7528\\u7528\\u6237\\u8bc4\\u4ef7\\u548c\\u8bc4\\u8bba\\u7cfb\\u7edf\\uff0c\\u5e2e\\u52a9\\u60a8\\u4e86\\u89e3\\u6f5c\\u5728\\u5408\\u4f5c\\u4f19\\u4f34\\u7684\\u4fe1\\u8a89\\uff0c\\u786e\\u4fdd\\u66f4\\u5b89\\u5168\\u7684\\u5546\\u4e1a\\u4ea4\\u6613\\u3002\\r\\n<\\/p><p>* \\u884c\\u4e1a\\u8d44\\u8baf\\u4e0e\\u5b66\\u4e60\\u5e73\\u53f0\\uff1a \\u6211\\u4eec\\u4e0d\\u4ec5\\u662f\\u4e00\\u4e2a\\u4ea4\\u6613\\u5e73\\u53f0\\uff0c\\u8fd8\\u63d0\\u4f9b\\u6700\\u65b0\\u7684\\u884c\\u4e1a\\u65b0\\u95fb\\u3001\\u6559\\u80b2\\u5185\\u5bb9\\u548c\\u8d8b\\u52bf\\u5206\\u6790\\uff0c\\u52a9\\u60a8\\u63d0\\u5347\\u7ade\\u4e89\\u529b\\u3002\\r\\n<\\/p><p>* \\u5168\\u7403\\u5e02\\u573a\\u62d3\\u5c55\\uff1a \\u63d0\\u4f9b\\u591a\\u8bed\\u8a00\\u652f\\u6301\\u3001\\u6c47\\u7387\\u4fe1\\u606f\\u548c\\u7269\\u6d41\\u6307\\u5357\\uff0c\\u52a9\\u529b\\u56fd\\u9645\\u8d38\\u6613\\uff0c\\u8ba9\\u60a8\\u8f7b\\u677e\\u8fde\\u63a5\\u5168\\u7403\\u5e02\\u573a\\u3002\\r\\n<\\/p><p>* \\u5e7f\\u544a\\u4e0e\\u5408\\u4f5c\\u673a\\u4f1a\\uff1a \\u901a\\u8fc7\\u591a\\u79cd\\u63a8\\u5e7f\\u65b9\\u6848\\u548c\\u6218\\u7565\\u5408\\u4f5c\\uff0c\\u5e2e\\u52a9\\u60a8\\u7684\\u54c1\\u724c\\u62d3\\u5c55\\u5e02\\u573a\\uff0c\\u63d0\\u5347\\u884c\\u4e1a\\u5f71\\u54cd\\u529b\\u3002\\r\\n<\\/p><p>Textile Forum \\u52a9\\u529b\\u6570\\u5b57\\u5316\\u8f6c\\u578b\\uff01\\r\\n<\\/p><p>\\u6211\\u4eec\\u7684\\u4f7f\\u547d\\u662f\\u63a8\\u52a8\\u7eba\\u7ec7\\u884c\\u4e1a\\u6570\\u5b57\\u5316\\uff0c\\u6ee1\\u8db3\\u73b0\\u4ee3\\u5546\\u4e1a\\u9700\\u6c42\\u3002Textile Forum \\u8ba9\\u7528\\u6237\\u62d3\\u5c55\\u4e1a\\u52a1\\uff0c\\u589e\\u5f3a\\u884c\\u4e1a\\u8054\\u7cfb\\uff0c\\u5e76\\u63d0\\u4f9b\\u521b\\u65b0\\u89e3\\u51b3\\u65b9\\u6848\\u3002\\r\\n<\\/p><p>\\u7acb\\u5373\\u52a0\\u5165\\u6211\\u4eec\\uff0c\\u4f53\\u9a8c Textile Forum \\u7684\\u4e13\\u5c5e\\u4f18\\u52bf\\uff0c\\u8ba9\\u60a8\\u7684\\u7eba\\u7ec7\\u8d38\\u6613\\u501f\\u52a9\\u6570\\u5b57\\u5316\\u529b\\u91cf\\u66f4\\u8fdb\\u4e00\\u6b65\\uff01<\\/p>\",\"padding_top\":\"20\",\"padding_bottom\":\"20\"}','2025-04-02 16:40:41','2025-04-02 16:40:43'),(46,'TextEditor','new','plugins\\PageBuilder\\Addons\\Common\\TextEditor','dynamic_page',1,23,'dynamic_page','{\"addon_name\":\"TextEditor\",\"addon_namespace\":\"cGx1Z2luc1xQYWdlQnVpbGRlclxBZGRvbnNcQ29tbW9uXFRleHRFZGl0b3I=\",\"addon_type\":\"new\",\"addon_location\":\"dynamic_page\",\"addon_order\":\"1\",\"addon_page_id\":\"23\",\"addon_page_type\":\"dynamic_page\",\"text_editor\":\"<p>Terms and Conditions - Textile Forum\\r\\n<\\/p><p>1. Introduction\\r\\n<\\/p><p>These Terms and Conditions apply to all users of TextileForum.net (hereinafter referred to as the \\\"platform\\\"). By using the platform, you agree to the following terms. If you do not accept these terms, you should refrain from using the platform.\\r\\n<\\/p><p>2. Service Description\\r\\n<\\/p><p>Textile Forum is a listing and communication platform for the textile industry. Users can post listings to sell, purchase, or find suppliers for textile products. Textile Forum acts solely as an intermediary and is not a party to any commercial transactions.\\r\\n<\\/p><p>3. Disclaimer of Liability\\r\\n<\\/p><p>* TextileForum.net is not responsible for any transactions or purchases conducted on the platform.\\r\\n<\\/p><p>* All transactions between users are solely their own responsibility.\\r\\n<\\/p><p>* Textile Forum does not guarantee the accuracy of user-submitted information and cannot be held responsible for listing content.\\r\\n<\\/p><p>* Any disputes arising from transactions on the platform must be resolved between users, and Textile Forum has no obligation to intervene.\\r\\n<\\/p><p>* Users acknowledge that all interactions on the platform are at their own risk.\\r\\n<\\/p><p>4. User Responsibilities\\r\\n<\\/p><p>* Users agree to use the platform in compliance with applicable laws.\\r\\n<\\/p><p>* Users must provide accurate and complete information in their listings.\\r\\n<\\/p><p>* Misuse of the platform is strictly prohibited.\\r\\n<\\/p><p>* Any actions that harm the reputation of Textile Forum, mislead users, or involve fraudulent activities are strictly forbidden.\\r\\n<\\/p><p>5. Membership and Account Security\\r\\n<\\/p><p>* Users are responsible for the accuracy of the information they provide when registering on Textile Forum.\\r\\n<\\/p><p>* Each user is responsible for securing their account and must not allow third parties to access it.\\r\\n<\\/p><p>* If you suspect your account security has been compromised, you must contact Textile Forum immediately.\\r\\n<\\/p><p>6. Content Policy\\r\\n<\\/p><p>* Users may not share illegal, misleading, or unethical content in their listings.\\r\\n<\\/p><p>* Textile Forum reserves the right to review and remove content as necessary.\\r\\n<\\/p><p>* Users who post fraudulent or deceptive listings may have their accounts suspended or permanently deleted.\\r\\n<\\/p><p>7. Third-Party Links\\r\\n<\\/p><p>Textile Forum may provide links to third-party websites. However, Textile Forum is not responsible for the content or security of these external sites. Users visit third-party websites at their own risk.\\r\\n<\\/p><p>8. Updates to the Terms\\r\\n<\\/p><p>These Terms and Conditions may be updated by Textile Forum from time to time. Users are responsible for keeping track of updates. The revised terms take effect once published on the platform.\\r\\n<\\/p><p>9. Contact\\r\\n<\\/p><p>For any questions regarding these Terms and Conditions, you can reach us at info@textileforum.net.\\r\\n<\\/p><p>Textile Forum aims to provide a secure and efficient platform for users. However, all transactions are the sole responsibility of users. We encourage you to use our platform responsibly&nbsp;and&nbsp;safely.<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p>\",\"padding_top\":\"20\",\"padding_bottom\":\"20\"}','2025-04-02 16:50:33','2025-04-02 16:50:33'),(47,'TextEditor','new','plugins\\PageBuilder\\Addons\\Common\\TextEditor','dynamic_page',1,24,'dynamic_page','{\"addon_name\":\"TextEditor\",\"addon_namespace\":\"cGx1Z2luc1xQYWdlQnVpbGRlclxBZGRvbnNcQ29tbW9uXFRleHRFZGl0b3I=\",\"addon_type\":\"new\",\"addon_location\":\"dynamic_page\",\"addon_order\":\"1\",\"addon_page_id\":\"24\",\"addon_page_type\":\"dynamic_page\",\"text_editor\":\"<p>\\u670d\\u52a1\\u6761\\u6b3e - Textile Forum\\r\\n<\\/p><p>1. \\u4ecb\\u7ecd\\r\\n<\\/p><p>\\u672c\\u300a\\u670d\\u52a1\\u6761\\u6b3e\\u300b\\u9002\\u7528\\u4e8e\\u6240\\u6709\\u4f7f\\u7528 TextileForum.net\\uff08\\u4ee5\\u4e0b\\u7b80\\u79f0\\u201c\\u5e73\\u53f0\\u201d\\uff09\\u7684\\u7528\\u6237\\u3002\\u4f7f\\u7528\\u672c\\u5e73\\u53f0\\u5373\\u8868\\u793a\\u60a8\\u540c\\u610f\\u4ee5\\u4e0b\\u6761\\u6b3e\\u3002\\u5982\\u4e0d\\u540c\\u610f\\uff0c\\u8bf7\\u52ff\\u4f7f\\u7528\\u672c\\u5e73\\u53f0\\u3002\\r\\n<\\/p><p>2. \\u670d\\u52a1\\u63cf\\u8ff0\\r\\n<\\/p><p>Textile Forum \\u662f\\u4e00\\u4e2a\\u4e13\\u4e3a\\u7eba\\u7ec7\\u884c\\u4e1a\\u6253\\u9020\\u7684\\u4fe1\\u606f\\u53d1\\u5e03\\u548c\\u4ea4\\u6d41\\u5e73\\u53f0\\u3002\\u7528\\u6237\\u53ef\\u4ee5\\u53d1\\u5e03\\u4fe1\\u606f\\u4ee5\\u51fa\\u552e\\u3001\\u8d2d\\u4e70\\u7eba\\u7ec7\\u4ea7\\u54c1\\u6216\\u5bfb\\u627e\\u4f9b\\u5e94\\u5546\\u3002Textile Forum \\u4ec5\\u4f5c\\u4e3a\\u4e2d\\u4ecb\\uff0c\\u4e0d\\u76f4\\u63a5\\u53c2\\u4e0e\\u4efb\\u4f55\\u5546\\u4e1a\\u4ea4\\u6613\\u3002\\r\\n<\\/p><p>3. \\u514d\\u8d23\\u58f0\\u660e\\r\\n<\\/p><p>* TextileForum.net \\u4e0d\\u5bf9\\u5e73\\u53f0\\u4e0a\\u7684\\u4efb\\u4f55\\u4ea4\\u6613\\u6216\\u8d2d\\u4e70\\u884c\\u4e3a\\u8d1f\\u8d23\\u3002\\r\\n<\\/p><p>* \\u6240\\u6709\\u4ea4\\u6613\\u5747\\u7531\\u7528\\u6237\\u81ea\\u884c\\u627f\\u62c5\\u8d23\\u4efb\\u3002\\r\\n<\\/p><p>* Textile Forum \\u4e0d\\u4fdd\\u8bc1\\u7528\\u6237\\u63d0\\u4f9b\\u7684\\u4fe1\\u606f\\u7684\\u51c6\\u786e\\u6027\\uff0c\\u4e14\\u4e0d\\u5bf9\\u4efb\\u4f55\\u4fe1\\u606f\\u5185\\u5bb9\\u627f\\u62c5\\u8d23\\u4efb\\u3002\\r\\n<\\/p><p>* \\u5e73\\u53f0\\u4e0a\\u7684\\u7ea0\\u7eb7\\u7531\\u7528\\u6237\\u81ea\\u884c\\u89e3\\u51b3\\uff0cTextile Forum \\u6ca1\\u6709\\u4ecb\\u5165\\u4e49\\u52a1\\u3002\\r\\n<\\/p><p>* \\u7528\\u6237\\u987b\\u81ea\\u884c\\u627f\\u62c5\\u5728\\u5e73\\u53f0\\u4e0a\\u8fdb\\u884c\\u7684\\u6240\\u6709\\u4e92\\u52a8\\u884c\\u4e3a\\u7684\\u98ce\\u9669\\u3002\\r\\n<\\/p><p>4. \\u7528\\u6237\\u4e49\\u52a1\\r\\n<\\/p><p>* \\u7528\\u6237\\u5fc5\\u987b\\u4f9d\\u6cd5\\u5408\\u89c4\\u4f7f\\u7528\\u5e73\\u53f0\\u3002\\r\\n<\\/p><p>* \\u53d1\\u5e03\\u4fe1\\u606f\\u9700\\u771f\\u5b9e\\u3001\\u5b8c\\u6574\\uff0c\\u4e0d\\u5f97\\u8bef\\u5bfc\\u6216\\u6b3a\\u9a97\\u4ed6\\u4eba\\u3002\\r\\n<\\/p><p>* \\u7528\\u6237\\u4e0d\\u5f97\\u6ee5\\u7528\\u5e73\\u53f0\\u6216\\u8fdb\\u884c\\u4efb\\u4f55\\u4e0d\\u6b63\\u5f53\\u884c\\u4e3a\\u3002\\r\\n<\\/p><p>* \\u7981\\u6b62\\u635f\\u5bb3 Textile Forum \\u4fe1\\u8a89\\u3001\\u8bef\\u5bfc\\u7528\\u6237\\u6216\\u6d89\\u53ca\\u6b3a\\u8bc8\\u7684\\u884c\\u4e3a\\u3002\\r\\n<\\/p><p>5. \\u8d26\\u6237\\u6ce8\\u518c\\u4e0e\\u5b89\\u5168\\r\\n<\\/p><p>* \\u7528\\u6237\\u5bf9\\u81ea\\u5df1\\u5728 Textile Forum \\u63d0\\u4f9b\\u7684\\u4fe1\\u606f\\u771f\\u5b9e\\u6027\\u8d1f\\u8d23\\u3002\\r\\n<\\/p><p>* \\u7528\\u6237\\u9700\\u81ea\\u884c\\u7ef4\\u62a4\\u8d26\\u6237\\u5b89\\u5168\\uff0c\\u4e0d\\u5f97\\u5141\\u8bb8\\u7b2c\\u4e09\\u65b9\\u4f7f\\u7528\\u5176\\u8d26\\u6237\\u3002\\r\\n<\\/p><p>* \\u82e5\\u53d1\\u73b0\\u8d26\\u6237\\u5b89\\u5168\\u53d7\\u5a01\\u80c1\\uff0c\\u5e94\\u7acb\\u5373\\u901a\\u77e5 Textile Forum\\u3002\\r\\n<\\/p><p>6. \\u5185\\u5bb9\\u653f\\u7b56\\r\\n<\\/p><p>* \\u7981\\u6b62\\u53d1\\u5e03\\u8fdd\\u6cd5\\u3001\\u8bef\\u5bfc\\u6216\\u4e0d\\u9053\\u5fb7\\u7684\\u5185\\u5bb9\\u3002\\r\\n<\\/p><p>* Textile Forum \\u4fdd\\u7559\\u5ba1\\u6838\\u548c\\u5220\\u9664\\u4e0d\\u5408\\u89c4\\u5185\\u5bb9\\u7684\\u6743\\u5229\\u3002\\r\\n<\\/p><p>* \\u53d1\\u5e03\\u865a\\u5047\\u6216\\u6b3a\\u8bc8\\u4fe1\\u606f\\u7684\\u7528\\u6237\\u53ef\\u80fd\\u4f1a\\u88ab\\u6682\\u505c\\u6216\\u6c38\\u4e45\\u5c01\\u7981\\u3002\\r\\n<\\/p><p>7. \\u7b2c\\u4e09\\u65b9\\u94fe\\u63a5\\r\\n<\\/p><p>Textile Forum \\u53ef\\u80fd\\u63d0\\u4f9b\\u6307\\u5411\\u7b2c\\u4e09\\u65b9\\u7f51\\u7ad9\\u7684\\u94fe\\u63a5\\uff0c\\u4f46\\u4e0d\\u5bf9\\u8fd9\\u4e9b\\u7f51\\u7ad9\\u7684\\u5185\\u5bb9\\u6216\\u5b89\\u5168\\u6027\\u8d1f\\u8d23\\u3002\\u7528\\u6237\\u8bbf\\u95ee\\u7b2c\\u4e09\\u65b9\\u7f51\\u7ad9\\u9700\\u81ea\\u884c\\u627f\\u62c5\\u98ce\\u9669\\u3002\\r\\n<\\/p><p>8. \\u6761\\u6b3e\\u66f4\\u65b0\\r\\n<\\/p><p>Textile Forum \\u53ef\\u80fd\\u4f1a\\u4e0d\\u5b9a\\u671f\\u66f4\\u65b0\\u672c\\u300a\\u670d\\u52a1\\u6761\\u6b3e\\u300b\\uff0c\\u7528\\u6237\\u6709\\u8d23\\u4efb\\u5173\\u6ce8\\u66f4\\u65b0\\u5185\\u5bb9\\u3002\\u66f4\\u65b0\\u540e\\u7684\\u6761\\u6b3e\\u81ea\\u53d1\\u5e03\\u4e4b\\u65e5\\u8d77\\u751f\\u6548\\u3002\\r\\n<\\/p><p>9. \\u8054\\u7cfb\\u65b9\\u5f0f\\r\\n<\\/p><p>\\u5982\\u5bf9\\u672c\\u300a\\u670d\\u52a1\\u6761\\u6b3e\\u300b\\u6709\\u4efb\\u4f55\\u7591\\u95ee\\uff0c\\u8bf7\\u901a\\u8fc7 info@textileforum.net \\u8054\\u7cfb\\u6211\\u4eec\\u3002\\r\\n<\\/p><p>Textile Forum \\u81f4\\u529b\\u4e8e\\u63d0\\u4f9b\\u5b89\\u5168\\u3001\\u9ad8\\u6548\\u7684\\u4ea4\\u6613\\u5e73\\u53f0\\uff0c\\u4f46\\u6240\\u6709\\u4ea4\\u6613\\u884c\\u4e3a\\u5747\\u7531\\u7528\\u6237\\u81ea\\u884c\\u8d1f\\u8d23\\u3002\\u8bf7\\u7406\\u6027\\u3001\\u5b89\\u5168\\u5730\\u4f7f\\u7528\\u5e73\\u53f0\\u3002<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p>\",\"padding_top\":\"20\",\"padding_bottom\":\"20\"}','2025-04-02 16:57:08','2025-04-02 16:57:08'),(48,'TextEditor','new','plugins\\PageBuilder\\Addons\\Common\\TextEditor','dynamic_page',1,25,'dynamic_page','{\"addon_name\":\"TextEditor\",\"addon_namespace\":\"cGx1Z2luc1xQYWdlQnVpbGRlclxBZGRvbnNcQ29tbW9uXFRleHRFZGl0b3I=\",\"addon_type\":\"new\",\"addon_location\":\"dynamic_page\",\"addon_order\":\"1\",\"addon_page_id\":\"25\",\"addon_page_type\":\"dynamic_page\",\"text_editor\":\"<p>Privacy Policy - Textile Forum\\r\\n<\\/p><p>Introduction\\r\\n<\\/p><p>At Textile Forum, we take your privacy seriously. This policy explains the information we collect, process, and use when you visit TextileForum.net. By using our platform, you agree to the terms outlined in this policy.\\r\\n<\\/p><p>1. Information We Collect and Its Purpose\\r\\n<\\/p><p>To facilitate listings and communication between members, we collect certain types of data:\\r\\n<\\/p><p>* Personal Information: Your name, surname, email address, and phone number.\\r\\n<\\/p><p>* Listing Information: Descriptions, images, and contact details you provide in your listings.\\r\\n<\\/p><p>* Account Information: Username, password, and other details necessary for account management.\\r\\n<\\/p><p>* Technical Data: Your IP address, browser type, and access timestamps.\\r\\n<\\/p><p>This information is used to enhance your experience, ensure security, and improve Textile Forum\\u2019s service quality.\\r\\n<\\/p><p>2. Data Sharing and Visibility\\r\\n<\\/p><p>The information you share in your listings is visible to other platform users. For example, if you include your phone number or email, other users can access this information. You have control over what you share, but we advise caution when providing personal details.\\r\\n<\\/p><p>Additionally, we may share data with official authorities if legally required.\\r\\n<\\/p><p>3. Data Security\\r\\n<\\/p><p>We take measures to protect user information. However, it is important to remember that no online data transmission is completely secure. Information shared in listings may be publicly accessible.\\r\\n<\\/p><p>4. Cookies and Tracking Technologies\\r\\n<\\/p><p>TextileForum.net uses cookies to improve your experience. Cookies help to:\\r\\n<\\/p><p>* Maintain session information.\\r\\n<\\/p><p>* Remember your preferences.\\r\\n<\\/p><p>* Analyze platform usage.\\r\\n<\\/p><p>You can adjust cookie settings in your browser, but some services may depend on cookies being enabled.\\r\\n<\\/p><p>5. User Rights\\r\\n<\\/p><p>As a Textile Forum user, you have the right to:\\r\\n<\\/p><p>* View, modify, or delete your account information.\\r\\n<\\/p><p>* Update or remove your listings.\\r\\n<\\/p><p>* Request information about how your personal data is used.\\r\\n<\\/p><p>For privacy or data security concerns, you can contact us at info@textileforum.net.\\r\\n<\\/p><p>6. Policy Updates\\r\\n<\\/p><p>This privacy policy may change over time. It is your responsibility to stay updated. The revised policy becomes effective once published on TextileForum.net.\\r\\n<\\/p><p>At Textile Forum, we are committed to maintaining a secure and transparent trade environment. We encourage users to be mindful of the information&nbsp;they&nbsp;share.\\r\\n<\\/p><p><br><\\/p>\",\"padding_top\":\"20\",\"padding_bottom\":\"20\"}','2025-04-02 17:06:16','2025-04-02 17:06:16'),(49,'TextEditor','update','plugins\\PageBuilder\\Addons\\Common\\TextEditor','dynamic_page',1,26,'dynamic_page','{\"id\":\"49\",\"addon_name\":\"TextEditor\",\"addon_namespace\":\"cGx1Z2luc1xQYWdlQnVpbGRlclxBZGRvbnNcQ29tbW9uXFRleHRFZGl0b3I=\",\"addon_type\":\"update\",\"addon_location\":\"dynamic_page\",\"addon_order\":\"1\",\"addon_page_id\":\"26\",\"addon_page_type\":\"dynamic_page\",\"text_editor\":\"<p>\\u9690\\u79c1\\u653f\\u7b56 - Textile Forum\\r\\n<\\/p><p>\\u7b80\\u4ecb\\r\\n<\\/p><p>\\u5728 Textile Forum\\uff0c\\u6211\\u4eec\\u975e\\u5e38\\u91cd\\u89c6\\u60a8\\u7684\\u9690\\u79c1\\u3002\\u672c\\u653f\\u7b56\\u8bf4\\u660e\\u4e86\\u5728\\u4f7f\\u7528 TextileForum.net \\u65f6\\uff0c\\u6211\\u4eec\\u5982\\u4f55\\u6536\\u96c6\\u3001\\u5904\\u7406\\u548c\\u4f7f\\u7528\\u60a8\\u7684\\u4fe1\\u606f\\u3002\\u901a\\u8fc7\\u4f7f\\u7528\\u672c\\u5e73\\u53f0\\uff0c\\u60a8\\u5373\\u8868\\u793a\\u540c\\u610f\\u672c\\u653f\\u7b56\\u7684\\u6761\\u6b3e\\u3002\\r\\n<\\/p><p>1. \\u6211\\u4eec\\u6536\\u96c6\\u7684\\u4fe1\\u606f\\u53ca\\u7528\\u9014\\r\\n<\\/p><p>\\u4e3a\\u4e86\\u5141\\u8bb8\\u7528\\u6237\\u53d1\\u5e03\\u4fe1\\u606f\\u5e76\\u4e0e\\u5176\\u4ed6\\u4f1a\\u5458\\u4ea4\\u6d41\\uff0c\\u6211\\u4eec\\u4f1a\\u6536\\u96c6\\u4ee5\\u4e0b\\u6570\\u636e\\uff1a\\r\\n<\\/p><p>* \\u4e2a\\u4eba\\u4fe1\\u606f\\uff1a \\u59d3\\u540d\\u3001\\u7535\\u5b50\\u90ae\\u4ef6\\u5730\\u5740\\u3001\\u7535\\u8bdd\\u53f7\\u7801\\u7b49\\u57fa\\u672c\\u4fe1\\u606f\\u3002\\r\\n<\\/p><p>* \\u53d1\\u5e03\\u4fe1\\u606f\\uff1a \\u60a8\\u5728\\u53d1\\u5e03\\u5185\\u5bb9\\u65f6\\u63d0\\u4f9b\\u7684\\u63cf\\u8ff0\\u3001\\u56fe\\u7247\\u548c\\u8054\\u7cfb\\u65b9\\u5f0f\\u3002\\r\\n<\\/p><p>* \\u8d26\\u6237\\u4fe1\\u606f\\uff1a \\u7528\\u6237\\u540d\\u3001\\u5bc6\\u7801\\u7b49\\u8d26\\u6237\\u7ba1\\u7406\\u6240\\u9700\\u7684\\u8d44\\u6599\\u3002\\r\\n<\\/p><p>* \\u6280\\u672f\\u6570\\u636e\\uff1a \\u60a8\\u7684 IP \\u5730\\u5740\\u3001\\u4f7f\\u7528\\u7684\\u6d4f\\u89c8\\u5668\\u4fe1\\u606f\\u3001\\u8bbf\\u95ee\\u65f6\\u95f4\\u7b49\\u6280\\u672f\\u6027\\u6570\\u636e\\u3002\\r\\n<\\/p><p>\\u8fd9\\u4e9b\\u4fe1\\u606f\\u7528\\u4e8e\\u4f18\\u5316\\u60a8\\u7684\\u5e73\\u53f0\\u4f7f\\u7528\\u4f53\\u9a8c\\u3001\\u63d0\\u5347\\u5b89\\u5168\\u6027\\uff0c\\u5e76\\u6539\\u8fdb Textile Forum \\u7684\\u670d\\u52a1\\u8d28\\u91cf\\u3002\\r\\n<\\/p><p>2. \\u4fe1\\u606f\\u5171\\u4eab\\u4e0e\\u53ef\\u89c1\\u6027\\r\\n<\\/p><p>\\u60a8\\u5728\\u53d1\\u5e03\\u5185\\u5bb9\\u65f6\\u63d0\\u4f9b\\u7684\\u4fe1\\u606f\\u53ef\\u80fd\\u4f1a\\u88ab\\u5176\\u4ed6\\u7528\\u6237\\u67e5\\u770b\\u3002\\u4f8b\\u5982\\uff0c\\u5982\\u679c\\u60a8\\u5728\\u53d1\\u5e03\\u5185\\u5bb9\\u4e2d\\u5305\\u542b\\u7535\\u8bdd\\u53f7\\u7801\\u6216\\u7535\\u5b50\\u90ae\\u4ef6\\u5730\\u5740\\uff0c\\u5176\\u4ed6\\u7528\\u6237\\u53ef\\u4ee5\\u8bbf\\u95ee\\u8fd9\\u4e9b\\u4fe1\\u606f\\u3002\\u60a8\\u53ef\\u4ee5\\u81ea\\u884c\\u51b3\\u5b9a\\u5982\\u4f55\\u5206\\u4eab\\u4fe1\\u606f\\uff0c\\u4f46\\u6211\\u4eec\\u5efa\\u8bae\\u60a8\\u8c28\\u614e\\u5904\\u7406\\u4e2a\\u4eba\\u6570\\u636e\\u3002\\u6b64\\u5916\\uff0c\\u6839\\u636e\\u6cd5\\u5f8b\\u8981\\u6c42\\uff0c\\u6211\\u4eec\\u53ef\\u80fd\\u4f1a\\u5411\\u5b98\\u65b9\\u673a\\u6784\\u63d0\\u4f9b\\u76f8\\u5173\\u4fe1\\u606f\\u3002\\r\\n<\\/p><p>3. \\u6570\\u636e\\u5b89\\u5168\\r\\n<\\/p><p>\\u6211\\u4eec\\u91c7\\u53d6\\u5fc5\\u8981\\u63aa\\u65bd\\u6765\\u4fdd\\u62a4\\u7528\\u6237\\u4fe1\\u606f\\u7684\\u5b89\\u5168\\u3002\\u7136\\u800c\\uff0c\\u8bf7\\u6ce8\\u610f\\uff0c\\u4e92\\u8054\\u7f51\\u6570\\u636e\\u4f20\\u8f93\\u5e76\\u975e 100% \\u5b89\\u5168\\u3002\\u5728\\u53d1\\u5e03\\u4fe1\\u606f\\u65f6\\uff0c\\u8bf7\\u7262\\u8bb0\\uff0c\\u60a8\\u7684\\u5185\\u5bb9\\u53ef\\u80fd\\u4f1a\\u5bf9\\u6240\\u6709\\u4eba\\u516c\\u5f00\\u3002\\r\\n<\\/p><p>4. \\u548c\\u8ffd\\u8e2a\\u6280\\u672f\\r\\n<\\/p><p>TextileForum.net \\u4f7f\\u7528 cookies \\u4ee5\\u63d0\\u5347\\u7528\\u6237\\u4f53\\u9a8c\\u3002Cookies \\u4e3b\\u8981\\u7528\\u4e8e\\uff1a\\r\\n<\\/p><p>* \\u8bb0\\u5f55\\u60a8\\u7684\\u4f1a\\u8bdd\\u4fe1\\u606f\\uff0c\\r\\n<\\/p><p>* \\u8bb0\\u4f4f\\u60a8\\u7684\\u4e2a\\u4eba\\u504f\\u597d\\uff0c\\r\\n<\\/p><p>* \\u5206\\u6790\\u5e73\\u53f0\\u4f7f\\u7528\\u60c5\\u51b5\\u3002\\r\\n<\\/p><p>\\u60a8\\u53ef\\u4ee5\\u5728\\u6d4f\\u89c8\\u5668\\u4e2d\\u66f4\\u6539 cookies \\u8bbe\\u7f6e\\uff0c\\u4f46\\u67d0\\u4e9b\\u529f\\u80fd\\u53ef\\u80fd\\u9700\\u8981 cookies \\u624d\\u80fd\\u6b63\\u5e38\\u8fd0\\u884c\\u3002\\r\\n<\\/p><p>5. \\u7528\\u6237\\u6743\\u5229\\r\\n<\\/p><p>\\u5728 Textile Forum\\uff0c\\u60a8\\u53ef\\u4ee5\\uff1a\\r\\n<\\/p><p>* \\u67e5\\u770b\\u3001\\u4fee\\u6539\\u6216\\u5220\\u9664\\u60a8\\u7684\\u8d26\\u6237\\u4fe1\\u606f\\uff0c\\r\\n<\\/p><p>* \\u66f4\\u65b0\\u6216\\u79fb\\u9664\\u60a8\\u7684\\u53d1\\u5e03\\u5185\\u5bb9\\uff0c\\r\\n<\\/p><p>* \\u4e86\\u89e3\\u60a8\\u7684\\u4e2a\\u4eba\\u6570\\u636e\\u5982\\u4f55\\u88ab\\u4f7f\\u7528\\u3002\\r\\n<\\/p><p>\\u5982\\u679c\\u60a8\\u6709\\u4efb\\u4f55\\u9690\\u79c1\\u6216\\u6570\\u636e\\u5b89\\u5168\\u65b9\\u9762\\u7684\\u7591\\u95ee\\uff0c\\u8bf7\\u901a\\u8fc7 info@textileforum.net \\u8054\\u7cfb\\u6211\\u4eec\\u3002\\r\\n<\\/p><p>6. \\u653f\\u7b56\\u66f4\\u65b0\\r\\n<\\/p><p>\\u672c\\u9690\\u79c1\\u653f\\u7b56\\u53ef\\u80fd\\u4f1a\\u968f\\u7740\\u65f6\\u95f4\\u63a8\\u79fb\\u800c\\u66f4\\u6539\\u3002\\u8bf7\\u6ce8\\u610f\\uff0c\\u60a8\\u6709\\u8d23\\u4efb\\u5b9a\\u671f\\u67e5\\u770b\\u66f4\\u65b0\\u4fe1\\u606f\\u3002\\u66f4\\u65b0\\u540e\\u7684\\u653f\\u7b56\\u5728 TextileForum.net \\u53d1\\u5e03\\u540e\\u5373\\u751f\\u6548\\u3002\\r\\n<\\/p><p>Textile Forum \\u81f4\\u529b\\u4e8e\\u6253\\u9020\\u5b89\\u5168\\u3001\\u900f\\u660e\\u7684\\u4ea4\\u6613\\u73af\\u5883\\uff0c\\u5e76\\u9f13\\u52b1\\u7528\\u6237\\u5728\\u5171\\u4eab\\u4fe1\\u606f\\u65f6\\u4fdd\\u6301\\u8c28\\u614e\\u3002<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p>\",\"padding_top\":\"20\",\"padding_bottom\":\"20\"}','2025-04-02 17:07:35','2025-04-02 17:07:38'),(50,'TextEditor','new','plugins\\PageBuilder\\Addons\\Common\\TextEditor','dynamic_page',1,27,'dynamic_page','{\"addon_name\":\"TextEditor\",\"addon_namespace\":\"cGx1Z2luc1xQYWdlQnVpbGRlclxBZGRvbnNcQ29tbW9uXFRleHRFZGl0b3I=\",\"addon_type\":\"new\",\"addon_location\":\"dynamic_page\",\"addon_order\":\"1\",\"addon_page_id\":\"27\",\"addon_page_type\":\"dynamic_page\",\"text_editor\":\"<p>\\r\\n<\\/p><div><span style=\\\"color: var(--paragraph-color); text-align: var(--bs-body-text-align);\\\">Personal Data Protection Law (KVKK) Information Notice<\\/span><\\/div><div>1. Introduction\\r\\n<\\/div><div>At Textile Forum, we place great importance on protecting our users\' personal data in accordance with the Law on the Protection of Personal Data No. 6698 (KVKK). This notice explains how personal data is processed, stored, and protected when using the TextileForum.net platform.\\r\\n<\\/div><div>2. Purposes of Processing Personal Data\\r\\n<\\/div><div>The personal data we collect from users is processed for the following purposes:\\r\\n<\\/div><div>* Creating and managing user accounts,\\r\\n<\\/div><div>* Providing listing services to users,\\r\\n<\\/div><div>* Facilitating communication between users,\\r\\n<\\/div><div>* Enhancing platform security and preventing fraud,\\r\\n<\\/div><div>* Conducting analytics and statistical studies to improve user experience,\\r\\n<\\/div><div>* Using data for marketing purposes, provided explicit consent is given for commercial electronic communication,\\r\\n<\\/div><div>* Complying with legal obligations.\\r\\n<\\/div><div>3. Processed Personal Data\\r\\n<\\/div><div>The types of personal data processed on our platform include:\\r\\n<\\/div><div>* Identity Information: Name, surname\\r\\n<\\/div><div>* Contact Information: Phone number, email address\\r\\n<\\/div><div>* Account Information: Username, password\\r\\n<\\/div><div>* Listing Information: Content added by users (photos, descriptions, etc.)\\r\\n<\\/div><div>* Technical Data: IP address, device details, cookies\\r\\n<\\/div><div>Users acknowledge that if they share contact information (such as phone number or email) in their listings, it may be visible to other users.\\r\\n<\\/div><div>4. Methods and Legal Basis for Collecting Personal Data\\r\\n<\\/div><div>Personal data is collected automatically or manually when users register, post listings, or use TextileForum.net. These processes are carried out based on the following legal grounds outlined in Articles 5 and 6 of the KVKK:\\r\\n<\\/div><div>* When explicitly required by law,\\r\\n<\\/div><div>* When necessary for the establishment or execution of a contract,\\r\\n<\\/div><div>* When required to fulfill legal obligations,\\r\\n<\\/div><div>* When explicit user consent is obtained.\\r\\n<\\/div><div>5. Retention Period of Personal Data\\r\\n<\\/div><div>Personal data is retained only for the period necessary for its intended purpose. Once the retention period expires, the data is deleted, destroyed, or anonymized in compliance with KVKK and relevant legal regulations.\\r\\n<\\/div><div>6. Sharing of Personal Data with Third Parties\\r\\n<\\/div><div>Textile Forum shares users\' personal data with third parties only in the following cases:\\r\\n<\\/div><div>* When required by legal obligations, with official authorities,\\r\\n<\\/div><div>* With business partners, provided the user has given explicit consent,\\r\\n<\\/div><div>* With service providers offering infrastructure and technical services.\\r\\n<\\/div><div>Textile Forum does not sell personal data to third parties for marketing or commercial purposes.\\r\\n<\\/div><div>7. User Rights\\r\\n<\\/div><div>Under KVKK, users have the right to:\\r\\n<\\/div><div>* Inquire whether their personal data has been processed,\\r\\n<\\/div><div>* Request information regarding the processing of their data,\\r\\n<\\/div><div>* Request correction of incomplete or inaccurate data,\\r\\n<\\/div><div>* Request deletion or destruction of their processed data,\\r\\n<\\/div><div>* Request notification of third parties with whom the data has been shared regarding any corrections or deletions,\\r\\n<\\/div><div>* Object to automated data processing results,\\r\\n<\\/div><div>* Seek compensation for damages incurred due to unlawful data processing.\\r\\n<\\/div><div>Users wishing to exercise these rights may contact Textile Forum at info@textileforum.net.\\r\\n<\\/div><div>8. Security Measures\\r\\n<\\/div><div>Textile Forum takes necessary technical and administrative measures to ensure the confidentiality and security of personal data. However, users should be aware that data transmission over the internet cannot be completely guaranteed as secure.\\r\\n<\\/div><div>9. Updates to the KVKK Notice\\r\\n<\\/div><div>This KVKK Information Notice may be updated due to changes in legislation or Textile Forum\\u2019s data processing policies. The updated version will become effective upon publication on the platform.\\r\\n<\\/div><div>Contact\\r\\n<\\/div><div>For any questions or KVKK-related requests, please reach us at info@textileforum.net.\\r\\n<\\/div><div>At Textile Forum, we prioritize the security of your personal data and are committed to providing a transparent and reliable&nbsp;service.<\\/div><div>\\r\\n<\\/div><div>\\r\\n<\\/div><div>\\r\\n<\\/div><div>\\r\\n<\\/div><div>\\r\\n<\\/div><div>\\r\\n<\\/div><div>\\r\\n<\\/div><div>\\r\\n<\\/div><div>\\r\\n<\\/div>\",\"padding_top\":\"20\",\"padding_bottom\":\"20\"}','2025-04-02 17:09:07','2025-04-02 17:09:07'),(51,'TextEditor','update','plugins\\PageBuilder\\Addons\\Common\\TextEditor','dynamic_page',1,28,'dynamic_page','{\"id\":\"51\",\"addon_name\":\"TextEditor\",\"addon_namespace\":\"cGx1Z2luc1xQYWdlQnVpbGRlclxBZGRvbnNcQ29tbW9uXFRleHRFZGl0b3I=\",\"addon_type\":\"update\",\"addon_location\":\"dynamic_page\",\"addon_order\":\"1\",\"addon_page_id\":\"28\",\"addon_page_type\":\"dynamic_page\",\"text_editor\":\"<p>\\u4e2a\\u4eba\\u6570\\u636e\\u4fdd\\u62a4\\u6cd5\\uff08KVKK\\uff09\\u8bf4\\u660e\\u58f0\\u660e\\r\\n<\\/p><p>1. \\u4ecb\\u7ecd\\r\\n<\\/p><p>\\u5728 Textile Forum\\uff0c\\u6211\\u4eec\\u9ad8\\u5ea6\\u91cd\\u89c6\\u7528\\u6237\\u7684\\u4e2a\\u4eba\\u6570\\u636e\\u4fdd\\u62a4\\uff0c\\u5e76\\u9075\\u5b88 \\u300a\\u4e2a\\u4eba\\u6570\\u636e\\u4fdd\\u62a4\\u6cd5\\u300b\\uff08KVKK\\uff09\\u7b2c 6698 \\u53f7\\u6cd5\\u5f8b\\u3002\\u672c\\u58f0\\u660e\\u65e8\\u5728\\u89e3\\u91ca\\u7528\\u6237\\u5728\\u4f7f\\u7528 TextileForum.net \\u5e73\\u53f0\\u65f6\\uff0c\\u5176\\u4e2a\\u4eba\\u6570\\u636e\\u7684\\u5904\\u7406\\u76ee\\u7684\\u3001\\u5b58\\u50a8\\u65b9\\u5f0f\\u4ee5\\u53ca\\u4fdd\\u62a4\\u63aa\\u65bd\\u3002\\r\\n<\\/p><p>2. \\u4e2a\\u4eba\\u6570\\u636e\\u7684\\u5904\\u7406\\u76ee\\u7684\\r\\n<\\/p><p>\\u6211\\u4eec\\u6536\\u96c6\\u7684\\u4e2a\\u4eba\\u6570\\u636e\\u5c06\\u7528\\u4e8e\\u4ee5\\u4e0b\\u76ee\\u7684\\uff1a\\r\\n<\\/p><p>* \\u521b\\u5efa\\u548c\\u7ba1\\u7406\\u7528\\u6237\\u8d26\\u6237\\uff0c\\r\\n<\\/p><p>* \\u4e3a\\u7528\\u6237\\u63d0\\u4f9b\\u4fe1\\u606f\\u53d1\\u5e03\\u670d\\u52a1\\uff0c\\r\\n<\\/p><p>* \\u4fc3\\u8fdb\\u7528\\u6237\\u4e4b\\u95f4\\u7684\\u4ea4\\u6d41\\uff0c\\r\\n<\\/p><p>* \\u63d0\\u9ad8\\u5e73\\u53f0\\u5b89\\u5168\\u6027\\uff0c\\u9632\\u6b62\\u6b3a\\u8bc8\\u884c\\u4e3a\\uff0c\\r\\n<\\/p><p>* \\u8fdb\\u884c\\u5206\\u6790\\u548c\\u7edf\\u8ba1\\u7814\\u7a76\\uff0c\\u4ee5\\u4f18\\u5316\\u7528\\u6237\\u4f53\\u9a8c\\uff0c\\r\\n<\\/p><p>* \\u5728\\u7528\\u6237\\u660e\\u786e\\u540c\\u610f\\u7684\\u60c5\\u51b5\\u4e0b\\uff0c\\u7528\\u4e8e\\u8425\\u9500\\u6d3b\\u52a8\\u548c\\u5546\\u4e1a\\u7535\\u5b50\\u901a\\u4fe1\\uff0c\\r\\n<\\/p><p>* \\u5c65\\u884c\\u6cd5\\u5f8b\\u4e49\\u52a1\\u3002\\r\\n<\\/p><p>3. \\u5904\\u7406\\u7684\\u4e2a\\u4eba\\u6570\\u636e\\r\\n<\\/p><p>\\u6211\\u4eec\\u5728\\u5e73\\u53f0\\u4e0a\\u5904\\u7406\\u7684\\u6570\\u636e\\u5305\\u62ec\\uff1a\\r\\n<\\/p><p>* \\u8eab\\u4efd\\u4fe1\\u606f\\uff1a \\u59d3\\u540d\\r\\n<\\/p><p>* \\u8054\\u7cfb\\u65b9\\u5f0f\\uff1a \\u7535\\u8bdd\\u53f7\\u7801\\u3001\\u7535\\u5b50\\u90ae\\u4ef6\\u5730\\u5740\\r\\n<\\/p><p>* \\u8d26\\u6237\\u4fe1\\u606f\\uff1a \\u7528\\u6237\\u540d\\u3001\\u5bc6\\u7801\\r\\n<\\/p><p>* \\u53d1\\u5e03\\u4fe1\\u606f\\uff1a \\u7528\\u6237\\u4e0a\\u4f20\\u7684\\u5185\\u5bb9\\uff08\\u7167\\u7247\\u3001\\u63cf\\u8ff0\\u7b49\\uff09\\r\\n<\\/p><p>* \\u6280\\u672f\\u6570\\u636e\\uff1a IP \\u5730\\u5740\\u3001\\u8bbe\\u5907\\u4fe1\\u606f\\u3001Cookies\\r\\n<\\/p><p>\\u5f53\\u7528\\u6237\\u5728\\u53d1\\u5e03\\u5185\\u5bb9\\u65f6\\u5305\\u542b\\u8054\\u7cfb\\u65b9\\u5f0f\\uff08\\u5982\\u7535\\u8bdd\\u6216\\u7535\\u5b50\\u90ae\\u4ef6\\uff09\\uff0c\\u5373\\u8868\\u793a\\u5176\\u540c\\u610f\\u8be5\\u4fe1\\u606f\\u53ef\\u80fd\\u88ab\\u5176\\u4ed6\\u7528\\u6237\\u67e5\\u770b\\u3002\\r\\n<\\/p><p>4. \\u4e2a\\u4eba\\u6570\\u636e\\u7684\\u6536\\u96c6\\u65b9\\u5f0f\\u53ca\\u6cd5\\u5f8b\\u4f9d\\u636e\\r\\n<\\/p><p>\\u7528\\u6237\\u5728\\u6ce8\\u518c\\u3001\\u53d1\\u5e03\\u4fe1\\u606f\\u6216\\u4f7f\\u7528 TextileForum.net \\u5e73\\u53f0\\u65f6\\uff0c\\u4e2a\\u4eba\\u6570\\u636e\\u4f1a\\u901a\\u8fc7\\u81ea\\u52a8\\u6216\\u624b\\u52a8\\u65b9\\u5f0f\\u6536\\u96c6\\u3002\\u6570\\u636e\\u5904\\u7406\\u57fa\\u4e8e KVKK \\u7b2c 5 \\u6761\\u548c\\u7b2c 6 \\u6761\\u89c4\\u5b9a\\u7684\\u4ee5\\u4e0b\\u6cd5\\u5f8b\\u4f9d\\u636e\\uff1a\\r\\n<\\/p><p>* \\u6cd5\\u5f8b\\u660e\\u786e\\u8981\\u6c42\\uff0c\\r\\n<\\/p><p>* \\u5c65\\u884c\\u5408\\u540c\\u7684\\u5fc5\\u8981\\u6027\\uff0c\\r\\n<\\/p><p>* \\u5c65\\u884c\\u6cd5\\u5b9a\\u4e49\\u52a1\\uff0c\\r\\n<\\/p><p>* \\u83b7\\u5f97\\u7528\\u6237\\u660e\\u786e\\u540c\\u610f\\u3002\\r\\n<\\/p><p>5. \\u4e2a\\u4eba\\u6570\\u636e\\u7684\\u5b58\\u50a8\\u671f\\u9650\\r\\n<\\/p><p>\\u4e2a\\u4eba\\u6570\\u636e\\u4ec5\\u5728\\u5904\\u7406\\u76ee\\u7684\\u6240\\u9700\\u7684\\u65f6\\u95f4\\u5185\\u5b58\\u50a8\\u3002\\u5f53\\u5b58\\u50a8\\u671f\\u9650\\u7ed3\\u675f\\u540e\\uff0c\\u76f8\\u5173\\u6570\\u636e\\u5c06\\u4f9d\\u636e KVKK \\u548c\\u5176\\u4ed6\\u9002\\u7528\\u6cd5\\u89c4\\u8fdb\\u884c\\u5220\\u9664\\u3001\\u9500\\u6bc1\\u6216\\u533f\\u540d\\u5316\\u5904\\u7406\\u3002\\r\\n<\\/p><p>6. \\u4e2a\\u4eba\\u6570\\u636e\\u7684\\u5171\\u4eab\\r\\n<\\/p><p>Textile Forum \\u4ec5\\u5728\\u4ee5\\u4e0b\\u60c5\\u51b5\\u4e0b\\u4e0e\\u7b2c\\u4e09\\u65b9\\u5171\\u4eab\\u7528\\u6237\\u4e2a\\u4eba\\u6570\\u636e\\uff1a\\r\\n<\\/p><p>* \\u4e3a\\u5c65\\u884c\\u6cd5\\u5f8b\\u4e49\\u52a1\\uff0c\\u5411\\u5b98\\u65b9\\u673a\\u6784\\u63d0\\u4f9b\\u6570\\u636e\\uff0c\\r\\n<\\/p><p>* \\u7528\\u6237\\u660e\\u786e\\u540c\\u610f\\u7684\\u60c5\\u51b5\\u4e0b\\uff0c\\u4e0e\\u4e1a\\u52a1\\u5408\\u4f5c\\u4f19\\u4f34\\u5171\\u4eab\\uff0c\\r\\n<\\/p><p>* \\u4e3a\\u63d0\\u4f9b\\u57fa\\u7840\\u8bbe\\u65bd\\u548c\\u6280\\u672f\\u652f\\u6301\\uff0c\\u4e0e\\u670d\\u52a1\\u63d0\\u4f9b\\u5546\\u5171\\u4eab\\u3002\\r\\n<\\/p><p>Textile Forum \\u4e0d\\u4f1a\\u5c06\\u7528\\u6237\\u4e2a\\u4eba\\u6570\\u636e\\u51fa\\u552e\\u7ed9\\u4efb\\u4f55\\u7b2c\\u4e09\\u65b9\\u7528\\u4e8e\\u8425\\u9500\\u6216\\u5546\\u4e1a\\u76ee\\u7684\\u3002\\r\\n<\\/p><p>7. \\u7528\\u6237\\u6743\\u5229\\r\\n<\\/p><p>\\u6839\\u636e KVKK\\uff0c\\u7528\\u6237\\u4eab\\u6709\\u4ee5\\u4e0b\\u6743\\u5229\\uff1a\\r\\n<\\/p><p>* \\u4e86\\u89e3\\u5176\\u4e2a\\u4eba\\u6570\\u636e\\u662f\\u5426\\u88ab\\u5904\\u7406\\uff0c\\r\\n<\\/p><p>* \\u82e5\\u6570\\u636e\\u5df2\\u88ab\\u5904\\u7406\\uff0c\\u5219\\u6709\\u6743\\u8981\\u6c42\\u76f8\\u5173\\u4fe1\\u606f\\uff0c\\r\\n<\\/p><p>* \\u5728\\u6570\\u636e\\u4e0d\\u5b8c\\u6574\\u6216\\u4e0d\\u51c6\\u786e\\u7684\\u60c5\\u51b5\\u4e0b\\uff0c\\u8bf7\\u6c42\\u66f4\\u6b63\\uff0c\\r\\n<\\/p><p>* \\u8981\\u6c42\\u5220\\u9664\\u6216\\u9500\\u6bc1\\u5df2\\u5904\\u7406\\u7684\\u6570\\u636e\\uff0c\\r\\n<\\/p><p>* \\u82e5\\u6570\\u636e\\u5df2\\u5171\\u4eab\\uff0c\\u6709\\u6743\\u8981\\u6c42\\u901a\\u77e5\\u76f8\\u5173\\u7b2c\\u4e09\\u65b9\\u8fdb\\u884c\\u66f4\\u6b63\\u6216\\u5220\\u9664\\uff0c\\r\\n<\\/p><p>* \\u5bf9\\u81ea\\u52a8\\u5316\\u6570\\u636e\\u5206\\u6790\\u7684\\u7ed3\\u679c\\u63d0\\u51fa\\u5f02\\u8bae\\uff0c\\r\\n<\\/p><p>* \\u56e0\\u6570\\u636e\\u5904\\u7406\\u8fdd\\u89c4\\u800c\\u53d7\\u5230\\u635f\\u5bb3\\u65f6\\uff0c\\u7533\\u8bf7\\u8d54\\u507f\\u3002\\r\\n<\\/p><p>\\u7528\\u6237\\u53ef\\u901a\\u8fc7 info@textileforum.net \\u8054\\u7cfb Textile Forum \\u4ee5\\u884c\\u4f7f\\u4e0a\\u8ff0\\u6743\\u5229\\u3002\\r\\n<\\/p><p>8. \\u5b89\\u5168\\u63aa\\u65bd\\r\\n<\\/p><p>Textile Forum \\u91c7\\u53d6\\u9002\\u5f53\\u7684\\u6280\\u672f\\u548c\\u7ba1\\u7406\\u63aa\\u65bd\\uff0c\\u786e\\u4fdd\\u4e2a\\u4eba\\u6570\\u636e\\u7684\\u9690\\u79c1\\u548c\\u5b89\\u5168\\u3002\\u7136\\u800c\\uff0c\\u8bf7\\u6ce8\\u610f\\uff0c\\u4e92\\u8054\\u7f51\\u6570\\u636e\\u4f20\\u8f93\\u5e76\\u4e0d\\u80fd\\u4fdd\\u8bc1\\u7edd\\u5bf9\\u5b89\\u5168\\u3002\\r\\n<\\/p><p>9. KVKK \\u58f0\\u660e\\u7684\\u66f4\\u65b0\\r\\n<\\/p><p>\\u672c KVKK \\u8bf4\\u660e\\u58f0\\u660e \\u53ef\\u80fd\\u56e0\\u6cd5\\u5f8b\\u53d8\\u66f4\\u6216 Textile Forum \\u6570\\u636e\\u5904\\u7406\\u653f\\u7b56\\u7684\\u8c03\\u6574\\u800c\\u66f4\\u65b0\\u3002\\u66f4\\u65b0\\u540e\\u7684\\u7248\\u672c\\u5c06\\u5728 \\u5e73\\u53f0\\u53d1\\u5e03\\u540e\\u7acb\\u5373\\u751f\\u6548\\u3002\\r\\n<\\/p><p>\\u8054\\u7cfb\\u65b9\\u5f0f\\r\\n<\\/p><p>\\u5982\\u679c\\u60a8\\u5bf9\\u672c\\u58f0\\u660e\\u6216\\u60a8\\u7684 KVKK \\u6743\\u5229 \\u6709\\u4efb\\u4f55\\u7591\\u95ee\\uff0c\\u8bf7\\u901a\\u8fc7 info@textileforum.net \\u8054\\u7cfb\\u6211\\u4eec\\u3002\\r\\n<\\/p><p>Textile Forum \\u627f\\u8bfa\\u4fdd\\u62a4\\u60a8\\u7684\\u4e2a\\u4eba\\u6570\\u636e\\uff0c\\u5e76\\u4e3a\\u60a8\\u63d0\\u4f9b\\u900f\\u660e\\u3001\\u5b89\\u5168\\u3001\\u53ef\\u9760\\u7684\\u670d\\u52a1\\u3002<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p><p>\\r\\n<\\/p>\",\"padding_top\":\"20\",\"padding_bottom\":\"20\"}','2025-04-02 17:10:26','2025-04-02 17:10:28');
