/*!40000 ALTER TABLE `listing_tags` ENABLE KEYS */;
UNLOCK TABLES;

--
-- Table structure for table `listings`
--

DROP TABLE IF EXISTS `listings`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `listings` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `user_id` bigint unsigned DEFAULT NULL,
  `admin_id` bigint unsigned DEFAULT NULL,
  `category_id` bigint unsigned DEFAULT NULL,
  `sub_category_id` bigint unsigned DEFAULT NULL,
  `child_category_id` bigint unsigned DEFAULT NULL,
  `brand_id` bigint unsigned DEFAULT NULL,
  `country_id` bigint unsigned DEFAULT NULL,
  `state_id` bigint unsigned DEFAULT NULL,
  `city_id` bigint unsigned DEFAULT NULL,
  `title` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL,
  `slug` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL,
  `description` longtext COLLATE utf8mb4_unicode_ci,
  `image` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `gallery_images` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `video_url` text COLLATE utf8mb4_unicode_ci,
  `price` double NOT NULL DEFAULT '0',
  `negotiable` tinyint(1) NOT NULL DEFAULT '0',
  `condition` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `authenticity` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `phone` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `phone_hidden` tinyint(1) NOT NULL DEFAULT '0',
  `phone_shows_only_premium` int DEFAULT '0',
  `address` text COLLATE utf8mb4_unicode_ci,
  `lat` decimal(10,7) DEFAULT NULL,
  `lon` decimal(10,7) DEFAULT NULL,
  `is_featured` tinyint(1) NOT NULL DEFAULT '0',
  `view` int NOT NULL DEFAULT '0',
  `status` tinyint(1) NOT NULL DEFAULT '0',
  `is_published` tinyint(1) NOT NULL DEFAULT '0',
  `published_at` timestamp NULL DEFAULT NULL,
  `deleted_at` timestamp NULL DEFAULT NULL,
  `created_at` timestamp NULL DEFAULT NULL,
  `updated_at` timestamp NULL DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=231 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

--
-- Dumping data for table `listings`
--

LOCK TABLES `listings` WRITE;
/*!40000 ALTER TABLE `listings` DISABLE KEYS */;
INSERT INTO `listings` VALUES (1,1,NULL,2,8,NULL,3,16,NULL,NULL,'Logitech E19 Computer Keyboard for sell','logitech-e19-computer-keyboard-for-sell','<p></p><div style=\"margin: 0px 28.7969px 0px 14.3906px; padding: 0px; width: 436.797px; text-align: left; float: right; color: rgb(0, 0, 0); font-family: &quot;Open Sans&quot;, Arial, sans-serif; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;\"></div><p></p><div style=\"text-align: justify;\"><span style=\"color: rgb(102, 112, 133); font-family: &quot;Source Sans Pro&quot;, sans-serif; text-align: start;\">Direct repair of aneurysm, pseudoaneurysm, or excision (partial or total) and graft insertion, with or without patch graft; for aneurysm, pseudoaneurysm, and associated occlusive disease, abdominal aorta involving iliac vessels (common, hypogastric, external)</span><br></div>','414','690|689',NULL,500,1,'new','refurbished','+8801799328264',1,0,'Dhaka, Bangladesh',90.3469270,23.8122516,1,850,1,1,'2024-06-11 03:12:03','2025-01-30 20:24:20','2024-04-24 06:30:12','2025-01-30 20:24:20'),(2,1,NULL,2,10,NULL,3,12,NULL,NULL,'Ginior G+ Mouse for Sell at reasonable price','ginior-g-mouse-for-sell-at-reasonable-price','<p><span style=\"font-family: &quot;Source Sans Pro&quot;, sans-serif;\">Direct repair of aneurysm, pseudoaneurysm, or excision (partial or total) and graft insertion, with or without patch graft; for aneurysm, pseudoaneurysm, and associated occlusive disease, abdominal aorta involving iliac vessels (common, hypogastric, external)</span><br></p>','411','687|688',NULL,499,1,'used','original','+8801784677515',0,0,'Dhaka, Bangladesh',23.8758547,90.3795438,0,1348,1,1,'2024-06-11 03:12:03','2025-01-30 20:24:20','2024-04-24 07:27:11','2025-01-30 20:24:20'),(3,1,NULL,4,16,NULL,3,12,NULL,NULL,'Original Chanel Perfume for Sell','original-chanel-perfume-for-sell','<p><span style=\"font-family: &quot;Source Sans Pro&quot;, sans-serif;\">Direct repair of aneurysm, pseudoaneurysm, or excision (partial or total) and graft insertion, with or without patch graft; for aneurysm, pseudoaneurysm, and associated occlusive disease, abdominal aorta involving iliac vessels (common, hypogastric, external)</span><br></p>','412','686',NULL,434,0,'new','refurbished','+8801799328264',0,0,'Dhaka, Bangladesh',23.7820624,90.4160527,0,429,1,1,'2024-06-11 03:12:03','2025-01-30 20:24:17','2024-04-24 23:07:10','2025-01-30 20:24:17'),(4,1,NULL,4,18,NULL,4,26,NULL,NULL,'Formal White T-Shirt for Office and Business Party','formal-white-t-shirt-for-office-and-business-party','<p>Elevate your professional look with this Formal White T-Shirt, perfect for both office wear and business parties. Crafted with premium cotton fabric, it offers comfort and breathability throughout the day. Its crisp white hue exudes sophistication and versatility, effortlessly pairing with suits or casual trousers. Designed with a tailored fit, it ensures a polished silhouette, making a lasting impression in any setting. Embrace timeless elegance and refined style with this essential wardrobe staple<br></p>','413','678|680',NULL,959,0,'used','original','+8801799328264',0,0,'Dhaka, Bangladesh',23.7936706,90.4066082,1,1116,1,1,'2024-06-11 03:12:03','2025-01-30 20:24:17','2024-04-24 23:33:36','2025-01-30 20:24:17'),(5,2,NULL,6,25,NULL,3,13,NULL,NULL,'Labrador Retriever','labrador-retriever','<p><span style=\"color: rgb(13, 13, 13); font-family: Söhne, ui-sans-serif, system-ui, -apple-system, &quot;Segoe UI&quot;, Roboto, Ubuntu, Cantarell, &quot;Noto Sans&quot;, sans-serif, &quot;Helvetica Neue&quot;, Arial, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;; white-space-collapse: preserve;\">The Labrador Retriever, renowned for its friendly demeanor and unwavering loyalty, stands as one of the most beloved canine companions worldwide. With a sturdy build and an expressive face, Labradors epitomize the quintessential family dog. Their coats come in three classic colors: black, chocolate, and yellow, each adding to their charm. Labradors are known for their intelligence and eagerness to please, making them highly trainable for various tasks, from assistance work to search and rescue missions. Their innate love for water and retrieving instincts harken back to their origins as fishing and hunting aides in Newfoundland, Canada. Despite their playful nature, Labradors possess a gentle disposition, especially around children, making them ideal family pets. Their boundless energy and zest for life ensure they thrive in active households, relishing outdoor adventures and playtime. Labradors excel in forming deep emotional bonds with their human companions, often serving as steadfast emotional support animals. With their infectious enthusiasm and unwavering devotion, Labradors continue to win hearts as cherished members of countless households worldwide.</span><br></p>','428',NULL,NULL,300,1,'new','original','+447464736755',0,0,'Moffat, United Kingdom',55.3780510,-3.4359730,0,510,1,1,'2024-06-11 03:12:03','2025-01-30 20:24:17','2024-04-27 01:57:28','2025-01-30 20:24:17'),(6,1,NULL,3,13,NULL,NULL,15,NULL,NULL,'5-Chair Dining Set','5-chair-dining-set','<p style=\"border: 0px solid rgb(227, 227, 227); --tw-border-spacing-x: 0; --tw-border-spacing-y: 0; --tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-nu